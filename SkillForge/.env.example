PORT=3000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillforge?retryWrites=true&w=majority

# Any long random string
SESSION_SECRET=change_this_to_a_long_random_string

# Set to "production" when deploying (enables secure cookies, trusts reverse proxy)
NODE_ENV=development

# Required for AI Career Coach, AI Resume Analyzer, AI Mock Interview.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — raises GitHub Integration's API rate limit from 60/hour to 5000/hour.
# Get a token at https://github.com/settings/tokens (no special scopes needed for public data)
GITHUB_TOKEN=
