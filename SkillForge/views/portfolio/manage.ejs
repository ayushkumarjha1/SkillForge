<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Portfolio | SkillForge</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif;}
body{background:#f4f7fc;padding:40px;}
.container{max-width:800px;margin:auto;}
h1{margin-bottom:6px;}
.sub{color:#888;font-size:14px;margin-bottom:25px;}
.card{background:white;padding:25px;border-radius:14px;box-shadow:0 8px 20px rgba(0,0,0,.06);margin-bottom:20px;}
.link-box{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;}
.link-box a{color:#4f46e5;font-weight:600;text-decoration:none;}
.theme-form{display:flex;gap:10px;align-items:center;}
select{padding:10px;border-radius:8px;border:1px solid #ccc;font-size:14px;}
.save-theme{background:#4f46e5;color:white;border:none;padding:10px 18px;border-radius:8px;font-weight:600;cursor:pointer;}
.proj-row{display:flex;justify-content:space-between;align-items:center;padding:14px 0;border-bottom:1px solid #eee;}
.proj-row:last-child{border-bottom:none;}
.proj-title{font-weight:600;}
.proj-meta{font-size:12px;color:#888;}
.toggle-form button{border:none;padding:8px 16px;border-radius:8px;font-weight:600;cursor:pointer;font-size:13px;}
.featured-on{background:#dcfce7;color:#16a34a;}
.featured-off{background:#f1f5f9;color:#64748b;}
.back{display:block;margin-top:20px;text-align:center;text-decoration:none;color:#666;}
.empty-note{color:#aaa;font-size:14px;}
</style>
</head>
<body>
<div class="container">

<h1>Portfolio</h1>
<p class="sub">Choose which projects show up on your public page, and pick a theme.</p>

<div class="card">
<div class="link-box">
<div>
<strong>Your public portfolio:</strong>
<% if (profileUser.username) { %>
<a href="/u/<%= profileUser.username %>" target="_blank">skillforge.com/u/<%= profileUser.username %> ↗</a>
<% } else { %>
<span class="empty-note">Set a username in <a href="/profile/edit">Edit Profile</a> first.</span>
<% } %>
</div>
<form class="theme-form" action="/portfolio/theme" method="POST">
<select name="portfolioTheme">
<option value="Dark" <%= profileUser.portfolioTheme === "Dark" ? "selected" : "" %>>Dark Theme</option>
<option value="Light" <%= profileUser.portfolioTheme === "Light" ? "selected" : "" %>>Light Theme</option>
</select>
<button type="submit" class="save-theme">Save Theme</button>
</form>
</div>
</div>

<div class="card">
<h3 style="margin-bottom:10px;">Featured Projects</h3>
<% if (projects.length === 0) { %>
<p class="empty-note">No projects yet — add some from the Projects page first.</p>
<% } else { %>
<% projects.forEach(proj => { %>
<div class="proj-row">
<div>
<div class="proj-title"><%= proj.title %></div>
<div class="proj-meta"><%= proj.category %> · <%= proj.status %></div>
</div>
<form class="toggle-form" action="/portfolio/toggle/<%= proj._id %>" method="POST">
<button type="submit" class="<%= proj.featured ? 'featured-on' : 'featured-off' %>">
<%= proj.featured ? '✓ Featured' : 'Add to Portfolio' %>
</button>
</form>
</div>
<% }) %>
<% } %>
</div>

<a class="back" href="/dashboard">← Back to Dashboard</a>

</div>
</body>
</html>
