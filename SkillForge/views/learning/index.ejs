<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Learning Hub | SkillForge</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif;}
body{background:#f4f7fc;padding:40px;}
.container{max-width:1000px;margin:auto;}
.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;}
.add-btn{background:#4f46e5;color:white;padding:12px 24px;border-radius:10px;text-decoration:none;font-weight:600;}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-bottom:25px;}
.stat{background:white;padding:18px;border-radius:12px;text-align:center;box-shadow:0 8px 20px rgba(0,0,0,.06);}
.stat .num{font-size:26px;font-weight:700;color:#4f46e5;}
.stat .label{font-size:12px;color:#888;}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px;}
.card{background:white;padding:20px;border-radius:14px;box-shadow:0 8px 20px rgba(0,0,0,.06);}
.card h3{font-size:16px;margin-bottom:4px;}
.meta{font-size:12px;color:#888;margin-bottom:10px;}
.progress-bar{background:#eee;height:8px;border-radius:20px;overflow:hidden;margin-bottom:6px;}
.progress-fill{height:100%;background:#4f46e5;}
.progress-label{font-size:11px;color:#999;margin-bottom:12px;}
.status{display:inline-block;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:600;background:#eef2ff;color:#4f46e5;margin-bottom:10px;}
.actions{display:flex;gap:8px;}
.actions a,.actions button{padding:6px 12px;border-radius:8px;text-decoration:none;font-size:12px;font-weight:600;border:none;cursor:pointer;}
.edit{background:#eef2ff;color:#4f46e5;}
.delete{background:#fee2e2;color:#dc2626;}
.empty{background:white;padding:60px;border-radius:15px;text-align:center;box-shadow:0 8px 20px rgba(0,0,0,.06);}
.back{display:block;margin-top:25px;text-align:center;text-decoration:none;color:#666;}
</style>
</head>
<body>
<div class="container">
<div class="header">
<h1>Learning Hub</h1>
<a class="add-btn" href="/learning/add">+ Add Course/Roadmap</a>
</div>

<div class="stats">
<div class="stat"><div class="num"><%= stats.total %></div><div class="label">Total</div></div>
<div class="stat"><div class="num"><%= stats.inProgress %></div><div class="label">In Progress</div></div>
<div class="stat"><div class="num"><%= stats.completed %></div><div class="label">Completed</div></div>
</div>

<% if (items.length === 0) { %>
<div class="empty"><h2>Nothing Added Yet</h2><p>Track the courses and roadmaps you're following.</p></div>
<% } else { %>
<div class="grid">
<% items.forEach(item => { %>
<div class="card">
<h3><%= item.title %></h3>
<div class="meta"><%= item.category %> <%= item.platform ? '· ' + item.platform : '' %></div>
<div class="status"><%= item.status %></div>
<div class="progress-bar"><div class="progress-fill" style="width:<%= item.progress %>%"></div></div>
<div class="progress-label"><%= item.progress %>% complete</div>
<div class="actions">
<a class="edit" href="/learning/edit/<%= item._id %>">Edit</a>
<form action="/learning/delete/<%= item._id %>" method="POST" onsubmit="return confirm('Delete?')">
<button class="delete" type="submit">Delete</button>
</form>
</div>
</div>
<% }) %>
</div>
<% } %>

<a class="back" href="/dashboard">← Back to Dashboard</a>
</div>
</body>
</html>
