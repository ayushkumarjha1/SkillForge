<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Learning Hub — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'learning' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Learning & Roadmap Hub' }) %>

      <div class="app-content animate-fade-in">
        <div class="page-header">
          <div>
            <h1 class="page-title">Learning & Skill Roadmaps</h1>
            <p class="page-subtitle">Track online courses, video tutorials, documentation guides, and revision intervals.</p>
          </div>
          <div class="page-actions">
            <a href="/learning/add" class="btn btn-primary">
              <i data-lucide="plus"></i>
              <span>Add Resource</span>
            </a>
          </div>
        </div>

        <!-- Metrics Grid -->
        <div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 1.75rem;">
          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Total Resources</span>
              <div class="stat-icon-wrapper"><i data-lucide="book-open"></i></div>
            </div>
            <div class="stat-value"><%= stats.total %></div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">In Progress</span>
              <div class="stat-icon-wrapper" style="background: var(--warning-light); color: var(--warning);"><i data-lucide="play"></i></div>
            </div>
            <div class="stat-value" style="color: var(--warning);"><%= stats.inProgress %></div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Completed</span>
              <div class="stat-icon-wrapper" style="background: var(--success-light); color: var(--success);"><i data-lucide="check-circle-2"></i></div>
            </div>
            <div class="stat-value" style="color: var(--success);"><%= stats.completed %></div>
          </div>
        </div>

        <% if (items.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon"><i data-lucide="book-open" style="width: 32px; height: 32px;"></i></div>
          <h2 class="empty-state-title">No Learning Items Tracked</h2>
          <p class="empty-state-desc">Add online courses, YouTube series, or tech books you are actively studying.</p>
          <a href="/learning/add" class="btn btn-primary"><i data-lucide="plus"></i> <span>Add First Resource</span></a>
        </div>
        <% } else { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
          <% items.forEach(item => { %>
          <div class="card card-hover" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
                <span class="badge <%= item.status === 'Completed' ? 'badge-success' : (item.status === 'In Progress' ? 'badge-warning' : 'badge-neutral') %>">
                  <%= item.status %>
                </span>
                <span style="font-size: 0.75rem; color: var(--text-muted);"><%= item.category %> <%= item.platform ? '· ' + item.platform : '' %></span>
              </div>

              <h3 style="font-size: 1.15rem; margin-bottom: 0.75rem;"><%= item.title %></h3>

              <div style="margin-bottom: 1rem;">
                <div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.35rem;">
                  <span style="color: var(--text-secondary);">Completion</span>
                  <span style="color: var(--primary);"><%= item.progress %>%</span>
                </div>
                <div class="progress-bar-container">
                  <div class="progress-bar-fill" style="width: <%= item.progress %>%;"></div>
                </div>
              </div>

              <% if (item.revisionDate) { %>
              <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.35rem;">
                <i data-lucide="clock" style="width: 12px; height: 12px;"></i> Revision: <%= item.revisionDate %>
              </div>
              <% } %>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border-subtle); padding-top: 0.85rem; margin-top: 0.85rem;">
              <div style="display: flex; gap: 0.5rem;">
                <% if (item.link) { %>
                <a href="<%= item.link %>" target="_blank" class="btn btn-secondary btn-sm">
                  <i data-lucide="external-link" style="width: 14px; height: 14px;"></i>
                  <span>Resource</span>
                </a>
                <% } %>
                <a href="/learning/edit/<%= item._id %>" class="btn btn-ghost btn-sm btn-icon" title="Edit">
                  <i data-lucide="edit-2" style="width: 15px; height: 15px;"></i>
                </a>
              </div>

              <form action="/learning/delete/<%= item._id %>" method="POST" onsubmit="return confirm('Delete learning item?')">
                <button type="submit" class="btn btn-ghost btn-sm btn-icon" style="color: var(--danger) !important;" title="Delete">
                  <i data-lucide="trash-2" style="width: 15px; height: 15px;"></i>
                </button>
              </form>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
