<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Edit Learning Item — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'learning' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Edit Learning Item' }) %>

      <div class="app-content animate-fade-in" style="max-width: 700px;">
        <div class="page-header">
          <div>
            <h1 class="page-title">Edit Learning Resource</h1>
            <p class="page-subtitle">Update details for "<%= item.title %>".</p>
          </div>
          <div class="page-actions">
            <a href="/learning" class="btn btn-secondary">
              <i data-lucide="arrow-left"></i>
              <span>Back to Hub</span>
            </a>
          </div>
        </div>

        <div class="card">
          <form action="/learning/edit/<%= item._id %>" method="POST">
            <div class="form-group">
              <label class="form-label" for="title">Resource Title *</label>
              <input type="text" id="title" name="title" class="form-control" value="<%= item.title %>" required>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="platform">Platform / Publisher</label>
                <input type="text" id="platform" name="platform" class="form-control" value="<%= item.platform %>">
              </div>

              <div class="form-group">
                <label class="form-label" for="category">Category</label>
                <select id="category" name="category" class="form-select">
                  <% ["Course","Roadmap","Book","YouTube Series","Other"].forEach(c => { %>
                  <option value="<%= c %>" <%= item.category === c ? "selected" : "" %>><%= c %></option>
                  <% }) %>
                </select>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="status">Status</label>
                <select id="status" name="status" class="form-select">
                  <% ["Not Started","In Progress","Completed"].forEach(s => { %>
                  <option value="<%= s %>" <%= item.status === s ? "selected" : "" %>><%= s %></option>
                  <% }) %>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="progress">Progress Percentage (%)</label>
                <input type="number" id="progress" name="progress" class="form-control" min="0" max="100" value="<%= item.progress %>">
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="link">Resource URL</label>
                <input type="url" id="link" name="link" class="form-control" value="<%= item.link %>">
              </div>

              <div class="form-group">
                <label class="form-label" for="revisionDate">Revision Date</label>
                <input type="text" id="revisionDate" name="revisionDate" class="form-control" value="<%= item.revisionDate %>">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="notes">Study Notes</label>
              <textarea id="notes" name="notes" class="form-textarea"><%= item.notes %></textarea>
            </div>

            <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
              <a href="/learning" class="btn btn-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary">
                <i data-lucide="check"></i>
                <span>Update Resource</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
