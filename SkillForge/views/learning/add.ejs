<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Add Learning Item — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'learning' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Add Learning Resource' }) %>

      <div class="app-content animate-fade-in" style="max-width: 700px;">
        <div class="page-header">
          <div>
            <h1 class="page-title">Add Learning Resource</h1>
            <p class="page-subtitle">Track a course, tutorial series, or roadmap book.</p>
          </div>
          <div class="page-actions">
            <a href="/learning" class="btn btn-secondary">
              <i data-lucide="arrow-left"></i>
              <span>Back to Hub</span>
            </a>
          </div>
        </div>

        <div class="card">
          <form action="/learning/add" method="POST">
            <div class="form-group">
              <label class="form-label" for="title">Resource Title *</label>
              <input type="text" id="title" name="title" class="form-control" placeholder="e.g. Distributed Systems Architecture & Patterns" required autofocus>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="platform">Platform / Publisher</label>
                <input type="text" id="platform" name="platform" class="form-control" placeholder="e.g. Coursera, Udemy, YouTube, O'Reilly">
              </div>

              <div class="form-group">
                <label class="form-label" for="category">Category</label>
                <select id="category" name="category" class="form-select">
                  <option value="Course">Course</option>
                  <option value="Roadmap">Roadmap</option>
                  <option value="Book">Book</option>
                  <option value="YouTube Series">YouTube Series</option>
                  <option value="Other">Other</option>
                </select>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="status">Status</label>
                <select id="status" name="status" class="form-select">
                  <option value="Not Started">Not Started</option>
                  <option value="In Progress" selected>In Progress</option>
                  <option value="Completed">Completed</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="progress">Progress Percentage (%)</label>
                <input type="number" id="progress" name="progress" class="form-control" min="0" max="100" value="0">
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="link">Resource URL</label>
                <input type="url" id="link" name="link" class="form-control" placeholder="https://...">
              </div>

              <div class="form-group">
                <label class="form-label" for="revisionDate">Target Revision Date</label>
                <input type="text" id="revisionDate" name="revisionDate" class="form-control" placeholder="e.g. Sept 20, 2026">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="notes">Study Notes & Key Takeaways</label>
              <textarea id="notes" name="notes" class="form-textarea" placeholder="Key concepts, cheat sheets, questions to review..."></textarea>
            </div>

            <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
              <a href="/learning" class="btn btn-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary">
                <i data-lucide="plus"></i>
                <span>Save Resource</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
