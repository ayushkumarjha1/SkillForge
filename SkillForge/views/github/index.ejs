<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>GitHub Intelligence — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'github' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'GitHub Integration & Insights' }) %>

      <div class="app-content animate-fade-in" style="max-width: 900px;">
        <div class="page-header">
          <div>
            <h1 class="page-title">GitHub Developer Intelligence</h1>
            <p class="page-subtitle">Inspect public repository statistics, star counts, and language breakdowns.</p>
          </div>
        </div>

        <!-- Search Input Card -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <form action="/github" method="POST" style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 260px; position: relative;">
              <input type="text" name="username" class="form-control" placeholder="Enter GitHub username (e.g. torvalds, gaearon)" value="<%= githubData ? githubData.username : '' %>" required autofocus>
            </div>
            <button type="submit" class="btn btn-primary">
              <i data-lucide="github"></i>
              <span>Fetch Developer Stats</span>
            </button>
          </form>
          <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.75rem;">
            Powered by public GitHub REST API. To increase rate limits, set <code>GITHUB_TOKEN</code> in your <code>.env</code> file.
          </div>
        </div>

        <% if (error) { %>
        <div class="alert alert-danger">
          <i data-lucide="alert-circle" style="flex-shrink: 0; width: 20px; height: 20px;"></i>
          <span><%= error %></span>
        </div>
        <% } %>

        <% if (githubData) { %>
        <!-- Profile Header Card -->
        <div class="card animate-fade-in" style="margin-bottom: 1.5rem;">
          <div style="display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;">
            <img src="<%= githubData.avatar %>" alt="<%= githubData.username %>" style="width: 76px; height: 76px; border-radius: var(--radius-full); border: 2px solid var(--border-glow); box-shadow: var(--shadow-md);">
            <div style="flex: 1; min-width: 200px;">
              <h2 style="font-size: 1.35rem; font-weight: 700; margin-bottom: 0.2rem;"><%= githubData.name || githubData.username %></h2>
              <a href="<%= githubData.profileUrl %>" target="_blank" style="font-size: 0.85rem; color: var(--primary); font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem;">
                <span>github.com/<%= githubData.username %></span>
                <i data-lucide="external-link" style="width: 12px; height: 12px;"></i>
              </a>
              <% if (githubData.bio) { %>
              <p style="font-size: 0.875rem; color: var(--text-secondary); margin-top: 0.4rem; margin-bottom: 0;"><%= githubData.bio %></p>
              <% } %>
            </div>
          </div>

          <div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); margin-top: 1.5rem; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
            <div class="stat-card" style="padding: 0.75rem;">
              <div class="stat-label">Public Repos</div>
              <div class="stat-value" style="font-size: 1.4rem;"><%= githubData.publicRepos %></div>
            </div>
            <div class="stat-card" style="padding: 0.75rem;">
              <div class="stat-label">Followers</div>
              <div class="stat-value" style="font-size: 1.4rem;"><%= githubData.followers %></div>
            </div>
            <div class="stat-card" style="padding: 0.75rem;">
              <div class="stat-label">Following</div>
              <div class="stat-value" style="font-size: 1.4rem;"><%= githubData.following %></div>
            </div>
            <div class="stat-card" style="padding: 0.75rem;">
              <div class="stat-label">Total Stars</div>
              <div class="stat-value" style="font-size: 1.4rem; color: var(--warning);"><%= githubData.totalStars %></div>
            </div>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 1.5rem;">
          <!-- Top Languages -->
          <% if (Object.keys(githubData.languageCounts).length > 0) { %>
          <div class="card">
            <div class="card-header" style="margin-bottom: 1rem;">
              <h3 class="card-title" style="font-size: 1rem;">Top Languages (By Repository)</h3>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
              <% Object.entries(githubData.languageCounts).sort((a,b) => b[1]-a[1]).slice(0,10).forEach(([lang, count]) => { %>
              <span class="badge badge-primary" style="padding: 0.4rem 0.75rem; font-size: 0.8rem;">
                <%= lang %> &bull; <%= count %> repos
              </span>
              <% }) %>
            </div>
          </div>
          <% } %>

          <!-- Top Repos -->
          <% if (githubData.topRepos.length > 0) { %>
          <div class="card">
            <div class="card-header" style="margin-bottom: 1rem;">
              <h3 class="card-title" style="font-size: 1rem;">Top Repositories (By Stars)</h3>
            </div>
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
              <% githubData.topRepos.forEach(repo => { %>
              <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.65rem 0.85rem; background: var(--bg-subtle); border-radius: var(--radius-sm); border: 1px solid var(--border-subtle);">
                <a href="<%= repo.html_url %>" target="_blank" style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary); text-decoration: none;">
                  <%= repo.name %>
                </a>
                <div style="display: flex; align-items: center; gap: 0.75rem; font-size: 0.8rem; color: var(--text-muted);">
                  <% if (repo.language) { %><span><%= repo.language %></span><% } %>
                  <span style="display: inline-flex; align-items: center; gap: 0.2rem; color: var(--warning); font-weight: 600;">
                    <i data-lucide="star" style="width: 12px; height: 12px; fill: var(--warning);"></i> <%= repo.stargazers_count %>
                  </span>
                </div>
              </div>
              <% }) %>
            </div>
          </div>
          <% } %>
        </div>
        <% } %>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
