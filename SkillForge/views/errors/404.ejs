<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>404 — Page Not Found | SkillForge</title>
</head>
<body class="auth-page">
  <div class="auth-glow-bg"></div>

  <div class="auth-container" style="text-align: center;">
    <div class="auth-brand">
      <a href="/" class="brand-link" style="justify-content: center;">
        <div class="brand-icon">
          <i data-lucide="sparkles"></i>
        </div>
        <span>SkillForge</span>
      </a>
    </div>

    <div class="auth-card" style="text-align: center;">
      <div style="font-size: 5rem; font-weight: 800; line-height: 1; letter-spacing: -0.04em; background: linear-gradient(135deg, var(--primary) 0%, #8b5cf6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 0.5rem;">
        404
      </div>
      <h1 class="auth-title">Page Not Found</h1>
      <p class="auth-subtitle" style="margin-bottom: 1.75rem;">
        The requested resource could not be found or may have been relocated.
      </p>

      <div style="display: flex; gap: 0.75rem; justify-content: center;">
        <a href="/dashboard" class="btn btn-primary">
          <i data-lucide="layout-dashboard"></i>
          <span>Go to Dashboard</span>
        </a>
        <a href="/" class="btn btn-secondary">
          <i data-lucide="home"></i>
          <span>Home</span>
        </a>
      </div>
    </div>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
