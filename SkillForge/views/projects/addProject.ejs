<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Add Project — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'projects' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Create New Project' }) %>

      <div class="app-content animate-fade-in" style="max-width: 800px;">
        <div class="page-header">
          <div>
            <h1 class="page-title">Add New Project</h1>
            <p class="page-subtitle">Publish a new engineering project to your portfolio.</p>
          </div>
          <div class="page-actions">
            <a href="/projects" class="btn btn-secondary">
              <i data-lucide="arrow-left"></i>
              <span>Back to Projects</span>
            </a>
          </div>
        </div>

        <div class="card">
          <form action="/projects/add" method="POST" enctype="multipart/form-data">
            <div class="form-group">
              <label class="form-label" for="title">Project Title *</label>
              <input type="text" id="title" name="title" class="form-control" placeholder="e.g. Distributed Task Queue" required autofocus>
            </div>

            <div class="form-group">
              <label class="form-label" for="description">Description *</label>
              <textarea id="description" name="description" class="form-textarea" placeholder="Briefly describe what problem this project solves, system design choices, and key technical highlights..." required></textarea>
            </div>

            <div class="form-group">
              <label class="form-label" for="techStack">Tech Stack *</label>
              <input type="text" id="techStack" name="techStack" class="form-control" placeholder="e.g. Node.js, Express, Redis, PostgreSQL, Docker" required>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="githubLink">GitHub Repository URL</label>
                <input type="url" id="githubLink" name="githubLink" class="form-control" placeholder="https://github.com/username/repo">
              </div>

              <div class="form-group">
                <label class="form-label" for="liveLink">Live Demo URL</label>
                <input type="url" id="liveLink" name="liveLink" class="form-control" placeholder="https://my-app.vercel.app">
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="status">Project Status</label>
                <select id="status" name="status" class="form-select">
                  <option value="Planning">Planning</option>
                  <option value="In Progress">In Progress</option>
                  <option value="Completed" selected>Completed</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="category">Category</label>
                <select id="category" name="category" class="form-select">
                  <option value="Web App" selected>Web App</option>
                  <option value="Mobile App">Mobile App</option>
                  <option value="AI/ML">AI/ML</option>
                  <option value="Data Science">Data Science</option>
                  <option value="Game Dev">Game Dev</option>
                  <option value="DevOps/Tools">DevOps/Tools</option>
                  <option value="Other">Other</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="tags">Tags (Comma-Separated)</label>
              <input type="text" id="tags" name="tags" class="form-control" placeholder="e.g. typescript, microservices, hackathon, tailwind">
            </div>

            <div class="form-group">
              <label class="form-label" for="coverImage">Cover Image (Optional)</label>
              <input type="file" id="coverImage" name="coverImage" class="form-control" accept="image/*">
              <small class="form-hint">Recommended format: PNG, JPG, or WebP. Max 5MB.</small>
            </div>

            <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
              <a href="/projects" class="btn btn-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary">
                <i data-lucide="plus"></i>
                <span>Save Project</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
