<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Edit Project | SkillForge</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
background:#f4f7fc;
display:flex;
justify-content:center;
align-items:center;
min-height:100vh;
padding:30px;
}

.container{
width:100%;
max-width:700px;
background:white;
padding:35px;
border-radius:15px;
box-shadow:0 10px 25px rgba(0,0,0,.08);
}

h1{
margin-bottom:25px;
text-align:center;
}

input,
textarea,
select{
width:100%;
padding:12px;
margin-bottom:18px;
border:1px solid #ccc;
border-radius:8px;
font-size:15px;
}

textarea{
height:120px;
resize:vertical;
}

button{
width:100%;
padding:14px;
background:#4f46e5;
color:white;
border:none;
border-radius:8px;
font-size:16px;
font-weight:600;
cursor:pointer;
}

button:hover{
background:#4338ca;
}

.back{
display:block;
margin-top:18px;
text-align:center;
text-decoration:none;
color:#4f46e5;
font-weight:600;
}

label{
display:block;
font-size:13px;
font-weight:600;
color:#555;
margin-bottom:6px;
}

.cover-preview{
width:100%;
max-height:180px;
object-fit:cover;
border-radius:8px;
margin-bottom:12px;
}

.hint{
font-size:12px;
color:#888;
margin:-12px 0 16px;
}

</style>

</head>

<body>

<div class="container">

<h1>Edit Project</h1>

<form action="/projects/edit/<%= project._id %>" method="POST" enctype="multipart/form-data">

<input
type="text"
name="title"
value="<%= project.title %>"
required>

<textarea
name="description"
required><%= project.description %></textarea>

<input
type="text"
name="techStack"
value="<%= project.techStack %>"
required>

<input
type="url"
name="githubLink"
value="<%= project.githubLink %>">

<input
type="url"
name="liveLink"
value="<%= project.liveLink %>">

<select name="status">

<option value="Planning"
<%= project.status==="Planning" ? "selected" : "" %>>
Planning
</option>

<option value="In Progress"
<%= project.status==="In Progress" ? "selected" : "" %>>
In Progress
</option>

<option value="Completed"
<%= project.status==="Completed" ? "selected" : "" %>>
Completed
</option>

</select>

<select name="category">

<% ["Web App","Mobile App","AI/ML","Data Science","Game Dev","DevOps/Tools","Other"].forEach(cat => { %>
<option value="<%= cat %>" <%= project.category === cat ? "selected" : "" %>><%= cat %></option>
<% }) %>

</select>

<input
type="text"
name="tags"
placeholder="Tags, comma separated (e.g. react, api, hackathon)"
value="<%= (project.tags || []).join(', ') %>">

<% if (project.coverImage) { %>
<label>Current cover image</label>
<img class="cover-preview" src="/uploads/covers/<%= project.coverImage %>" alt="Current cover">
<% } %>

<label>Replace cover image</label>
<input type="file" name="coverImage" accept="image/*">
<p class="hint">Leave empty to keep the current cover image.</p>

<button type="submit">
Update Project
</button>

</form>

<a class="back" href="/projects">
← Back to Projects
</a>

</div>

</body>

</html>