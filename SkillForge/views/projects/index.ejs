<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Projects Hub — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'projects' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Projects Hub' }) %>

      <div class="app-content animate-fade-in">
        <!-- Page Header -->
        <div class="page-header">
          <div>
            <h1 class="page-title">Project Portfolio</h1>
            <p class="page-subtitle">Showcase software engineering projects, tech stacks, and live deployments.</p>
          </div>
          <div class="page-actions">
            <a href="/projects/add" class="btn btn-primary">
              <i data-lucide="plus"></i>
              <span>Create Project</span>
            </a>
          </div>
        </div>

        <!-- Filter & Search Bar -->
        <form class="card" method="GET" action="/projects" style="padding: 1.25rem; margin-bottom: 1.75rem;">
          <div style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: center;">
            <div style="flex: 1; min-width: 220px; position: relative;">
              <input
                type="text"
                name="q"
                class="form-control"
                placeholder="Search projects by title, tech stack, or tags..."
                value="<%= filters.q %>">
            </div>

            <div style="min-width: 150px;">
              <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="Planning" <%= filters.status === "Planning" ? "selected" : "" %>>Planning</option>
                <option value="In Progress" <%= filters.status === "In Progress" ? "selected" : "" %>>In Progress</option>
                <option value="Completed" <%= filters.status === "Completed" ? "selected" : "" %>>Completed</option>
              </select>
            </div>

            <div style="min-width: 160px;">
              <select name="category" class="form-select">
                <option value="">All Categories</option>
                <% ["Web App","Mobile App","AI/ML","Data Science","Game Dev","DevOps/Tools","Other"].forEach(cat => { %>
                <option value="<%= cat %>" <%= filters.category === cat ? "selected" : "" %>><%= cat %></option>
                <% }) %>
              </select>
            </div>

            <div style="min-width: 150px;">
              <select name="sort" class="form-select">
                <option value="newest" <%= filters.sort === "newest" ? "selected" : "" %>>Newest First</option>
                <option value="oldest" <%= filters.sort === "oldest" ? "selected" : "" %>>Oldest First</option>
                <option value="title-asc" <%= filters.sort === "title-asc" ? "selected" : "" %>>Title A-Z</option>
                <option value="title-desc" <%= filters.sort === "title-desc" ? "selected" : "" %>>Title Z-A</option>
              </select>
            </div>

            <button type="submit" class="btn btn-primary">
              <i data-lucide="filter" style="width: 16px; height: 16px;"></i>
              <span>Filter</span>
            </button>

            <% if (filters.q || filters.status || filters.category || filters.sort !== "newest") { %>
            <a href="/projects" class="btn btn-secondary">Clear</a>
            <% } %>
          </div>
        </form>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
          <span style="font-size: 0.875rem; color: var(--text-muted); font-weight: 500;">
            Showing <strong><%= pagination.totalProjects %></strong> project<%= pagination.totalProjects === 1 ? "" : "s" %>
          </span>
        </div>

        <% if (projects.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon">
            <i data-lucide="folder-git-2" style="width: 32px; height: 32px;"></i>
          </div>
          <h2 class="empty-state-title">No Projects Found</h2>
          <p class="empty-state-desc">
            No projects match your current filters. Adjust your search criteria or create your next software engineering project.
          </p>
          <a href="/projects/add" class="btn btn-primary">
            <i data-lucide="plus"></i>
            <span>Add First Project</span>
          </a>
        </div>
        <% } else { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.5rem;">
          <% projects.forEach(project => { %>
          <div class="card card-hover" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <% if (project.coverImage) { %>
              <div style="height: 180px; border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 1.25rem; background: var(--bg-subtle);">
                <img src="/uploads/covers/<%= project.coverImage %>" alt="<%= project.title %> cover" style="width: 100%; height: 100%; object-fit: cover;">
              </div>
              <% } %>

              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem; gap: 0.5rem; flex-wrap: wrap;">
                <span class="badge <%= project.status === 'Completed' ? 'badge-success' : (project.status === 'In Progress' ? 'badge-warning' : 'badge-primary') %>">
                  <%= project.status %>
                </span>
                <span class="badge badge-neutral"><%= project.category %></span>
              </div>

              <h2 style="font-size: 1.25rem; margin-bottom: 0.5rem;"><%= project.title %></h2>
              <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 1rem; line-height: 1.5;">
                <%= project.description %>
              </p>

              <div style="margin-bottom: 1rem;">
                <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.35rem;">Tech Stack</div>
                <div style="font-size: 0.85rem; font-weight: 600; color: var(--text-primary); font-family: var(--font-mono);">
                  <%= project.techStack %>
                </div>
              </div>

              <% if (project.tags && project.tags.length > 0) { %>
              <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1.25rem;">
                <% project.tags.forEach(tag => { %>
                <span style="font-size: 0.75rem; color: var(--text-muted); background: var(--bg-subtle); padding: 0.2rem 0.5rem; border-radius: var(--radius-xs);">
                  #<%= tag %>
                </span>
                <% }) %>
              </div>
              <% } %>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border-subtle); padding-top: 1rem; margin-top: 1rem; gap: 0.5rem;">
              <div style="display: flex; gap: 0.5rem;">
                <% if (project.githubLink) { %>
                <a href="<%= project.githubLink %>" target="_blank" class="btn btn-secondary btn-sm" aria-label="GitHub Repo">
                  <i data-lucide="github" style="width: 14px; height: 14px;"></i>
                  <span>Code</span>
                </a>
                <% } %>
                <% if (project.liveLink) { %>
                <a href="<%= project.liveLink %>" target="_blank" class="btn btn-primary btn-sm" aria-label="Live Demo">
                  <i data-lucide="external-link" style="width: 14px; height: 14px;"></i>
                  <span>Live</span>
                </a>
                <% } %>
              </div>

              <div style="display: flex; gap: 0.35rem;">
                <a href="/projects/edit/<%= project._id %>" class="btn btn-ghost btn-sm btn-icon" title="Edit Project">
                  <i data-lucide="edit-2" style="width: 16px; height: 16px;"></i>
                </a>
                <a href="/projects/delete/<%= project._id %>" class="btn btn-ghost btn-sm btn-icon" style="color: var(--danger) !important;" title="Delete Project" onclick="return confirm('Are you sure you want to delete this project?')">
                  <i data-lucide="trash-2" style="width: 16px; height: 16px;"></i>
                </a>
              </div>
            </div>
          </div>
          <% }) %>
        </div>

        <% if (pagination.totalPages > 1) { %>
        <div style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 2.5rem;">
          <% for(let p = 1; p <= pagination.totalPages; p++) { %>
            <% if (p === pagination.currentPage) { %>
            <span class="btn btn-primary btn-sm"><%= p %></span>
            <% } else { %>
            <a href="/projects?q=<%= encodeURIComponent(filters.q) %>&status=<%= encodeURIComponent(filters.status) %>&category=<%= encodeURIComponent(filters.category) %>&sort=<%= filters.sort %>&page=<%= p %>" class="btn btn-secondary btn-sm"><%= p %></a>
            <% } %>
          <% } %>
        </div>
        <% } %>

        <% } %>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>