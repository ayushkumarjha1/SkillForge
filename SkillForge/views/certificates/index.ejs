<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Certificates & Badges — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'certificates' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Certificates & Credentials' }) %>

      <div class="app-content animate-fade-in">
        <div class="page-header">
          <div>
            <h1 class="page-title">Certificates & Credentials</h1>
            <p class="page-subtitle">Showcase verified course completions, hackathon awards, and cloud certifications.</p>
          </div>
          <div class="page-actions">
            <a href="/certificates/add" class="btn btn-primary">
              <i data-lucide="plus"></i>
              <span>Add Certificate</span>
            </a>
          </div>
        </div>

        <% if (certificates.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon"><i data-lucide="award" style="width: 32px; height: 32px;"></i></div>
          <h2 class="empty-state-title">No Certificates Added</h2>
          <p class="empty-state-desc">Upload your AWS, Coursera, HackerRank, or hackathon certificates to display in your portfolio.</p>
          <a href="/certificates/add" class="btn btn-primary"><i data-lucide="plus"></i> <span>Add First Certificate</span></a>
        </div>
        <% } else { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
          <% certificates.forEach(cert => { %>
          <div class="card card-hover" style="display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; padding: 0;">
            <% if (cert.image) { %>
            <div style="height: 160px; background: var(--bg-subtle); overflow: hidden;">
              <img src="/uploads/certificates/<%= cert.image %>" alt="<%= cert.title %>" style="width: 100%; height: 100%; object-fit: cover;">
            </div>
            <% } else { %>
            <div style="height: 90px; background: linear-gradient(135deg, rgba(79, 70, 229, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%); display: flex; align-items: center; justify-content: center; color: var(--primary);">
              <i data-lucide="award" style="width: 36px; height: 36px;"></i>
            </div>
            <% } %>

            <div style="padding: 1.25rem; flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
                  <span class="badge badge-primary"><%= cert.category %></span>
                  <% if (cert.issueDate) { %>
                  <span style="font-size: 0.75rem; color: var(--text-muted);"><%= cert.issueDate %></span>
                  <% } %>
                </div>

                <h3 style="font-size: 1.1rem; margin-bottom: 0.35rem;"><%= cert.title %></h3>
                <div style="font-size: 0.85rem; color: var(--text-secondary); font-weight: 500; margin-bottom: 0.75rem;">
                  <i data-lucide="building" style="width: 13px; height: 13px; display: inline-block; vertical-align: middle;"></i> <%= cert.issuer %>
                </div>
              </div>

              <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border-subtle); padding-top: 0.75rem; margin-top: 0.75rem;">
                <div style="display: flex; gap: 0.5rem;">
                  <% if (cert.credentialUrl) { %>
                  <a href="<%= cert.credentialUrl %>" target="_blank" class="btn btn-secondary btn-sm">
                    <i data-lucide="external-link" style="width: 14px; height: 14px;"></i>
                    <span>Verify</span>
                  </a>
                  <% } %>
                  <a href="/certificates/edit/<%= cert._id %>" class="btn btn-ghost btn-sm btn-icon" title="Edit">
                    <i data-lucide="edit-2" style="width: 15px; height: 15px;"></i>
                  </a>
                </div>

                <form action="/certificates/delete/<%= cert._id %>" method="POST" onsubmit="return confirm('Delete certificate?')">
                  <button type="submit" class="btn btn-ghost btn-sm btn-icon" style="color: var(--danger) !important;" title="Delete">
                    <i data-lucide="trash-2" style="width: 15px; height: 15px;"></i>
                  </button>
                </form>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
