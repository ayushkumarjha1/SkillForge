<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Certificates | SkillForge</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif;}
body{background:#f4f7fc;padding:40px;}
.container{max-width:1100px;margin:auto;}
.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:30px;}
.add-btn{background:#4f46e5;color:white;padding:12px 24px;border-radius:10px;text-decoration:none;font-weight:600;}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:20px;}
.card{background:white;border-radius:14px;box-shadow:0 8px 20px rgba(0,0,0,.06);overflow:hidden;}
.cert-img{width:100%;height:140px;object-fit:cover;background:#eef2ff;}
.card-body{padding:18px;}
.card-body h3{font-size:16px;margin-bottom:4px;}
.issuer{font-size:13px;color:#666;margin-bottom:8px;}
.tag{display:inline-block;background:#eef2ff;color:#4f46e5;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:600;margin-bottom:10px;}
.date{font-size:12px;color:#999;margin-bottom:12px;}
.actions{display:flex;gap:8px;}
.actions a,.actions button{padding:6px 12px;border-radius:8px;text-decoration:none;font-size:12px;font-weight:600;border:none;cursor:pointer;}
.edit{background:#eef2ff;color:#4f46e5;}
.delete{background:#fee2e2;color:#dc2626;}
.view-cred{background:#111827;color:white;}
.empty{background:white;padding:60px;border-radius:15px;text-align:center;box-shadow:0 8px 20px rgba(0,0,0,.06);}
.back{display:block;margin-top:25px;text-align:center;text-decoration:none;color:#666;}
</style>
</head>
<body>
<div class="container">
<div class="header">
<h1>Certificates</h1>
<a class="add-btn" href="/certificates/add">+ Add Certificate</a>
</div>

<% if (certificates.length === 0) { %>
<div class="empty"><h2>No Certificates Yet</h2><p>Add your first certification, course completion, or hackathon badge.</p></div>
<% } else { %>
<div class="grid">
<% certificates.forEach(cert => { %>
<div class="card">
<% if (cert.image) { %><img class="cert-img" src="/uploads/certificates/<%= cert.image %>" alt="<%= cert.title %>"><% } %>
<div class="card-body">
<h3><%= cert.title %></h3>
<div class="issuer"><%= cert.issuer %></div>
<div class="tag"><%= cert.category %></div>
<% if (cert.issueDate) { %><div class="date">Issued: <%= cert.issueDate %></div><% } %>
<div class="actions">
<a class="edit" href="/certificates/edit/<%= cert._id %>">Edit</a>
<% if (cert.credentialUrl) { %><a class="view-cred" href="<%= cert.credentialUrl %>" target="_blank">View</a><% } %>
<form action="/certificates/delete/<%= cert._id %>" method="POST" onsubmit="return confirm('Delete this certificate?')">
<button class="delete" type="submit">Delete</button>
</form>
</div>
</div>
</div>
<% }) %>
</div>
<% } %>

<a class="back" href="/dashboard">← Back to Dashboard</a>
</div>
</body>
</html>
