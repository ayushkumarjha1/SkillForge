<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Add DSA Problem — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'dsa' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Log DSA Problem' }) %>

      <div class="app-content animate-fade-in" style="max-width: 700px;">
        <div class="page-header">
          <div>
            <h1 class="page-title">Log DSA Problem</h1>
            <p class="page-subtitle">Track problems from LeetCode, HackerRank, Codeforces, etc.</p>
          </div>
          <div class="page-actions">
            <a href="/dsa" class="btn btn-secondary">
              <i data-lucide="arrow-left"></i>
              <span>Back to Tracker</span>
            </a>
          </div>
        </div>

        <div class="card">
          <form action="/dsa/add" method="POST">
            <div class="form-group">
              <label class="form-label" for="title">Problem Title *</label>
              <input type="text" id="title" name="title" class="form-control" placeholder="e.g. Two Sum, LRU Cache, Trapping Rain Water" required autofocus>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="platform">Platform</label>
                <input type="text" id="platform" name="platform" class="form-control" value="LeetCode" placeholder="e.g. LeetCode, Codeforces">
              </div>

              <div class="form-group">
                <label class="form-label" for="topic">Topic / Category</label>
                <input type="text" id="topic" name="topic" class="form-control" placeholder="e.g. Dynamic Programming, Graphs">
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="difficulty">Difficulty</label>
                <select id="difficulty" name="difficulty" class="form-select">
                  <option value="Easy">Easy</option>
                  <option value="Medium" selected>Medium</option>
                  <option value="Hard">Hard</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="status">Status</label>
                <select id="status" name="status" class="form-select">
                  <option value="Todo">Todo</option>
                  <option value="Solved" selected>Solved</option>
                  <option value="Needs Revision">Needs Revision</option>
                </select>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="solvedDate">Solved Date (Auto-fills today if empty)</label>
                <input type="date" id="solvedDate" name="solvedDate" class="form-control">
              </div>

              <div class="form-group">
                <label class="form-label" for="link">Problem URL</label>
                <input type="url" id="link" name="link" class="form-control" placeholder="https://leetcode.com/problems/...">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="notes">Approach, Time/Space Complexity & Key Learnings</label>
              <textarea id="notes" name="notes" class="form-textarea" placeholder="e.g. Two-pointer approach with O(n) time, O(1) space. Watch out for edge case where array has duplicates..."></textarea>
            </div>

            <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
              <a href="/dsa" class="btn btn-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary">
                <i data-lucide="plus"></i>
                <span>Save Problem</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
