<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Edit DSA Problem — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'dsa' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Edit DSA Problem' }) %>

      <div class="app-content animate-fade-in" style="max-width: 700px;">
        <div class="page-header">
          <div>
            <h1 class="page-title">Edit Problem</h1>
            <p class="page-subtitle">Update details and approach notes for "<%= problem.title %>".</p>
          </div>
          <div class="page-actions">
            <a href="/dsa" class="btn btn-secondary">
              <i data-lucide="arrow-left"></i>
              <span>Back to Tracker</span>
            </a>
          </div>
        </div>

        <div class="card">
          <form action="/dsa/edit/<%= problem._id %>" method="POST">
            <div class="form-group">
              <label class="form-label" for="title">Problem Title *</label>
              <input type="text" id="title" name="title" class="form-control" value="<%= problem.title %>" required>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="platform">Platform</label>
                <input type="text" id="platform" name="platform" class="form-control" value="<%= problem.platform %>">
              </div>

              <div class="form-group">
                <label class="form-label" for="topic">Topic / Category</label>
                <input type="text" id="topic" name="topic" class="form-control" value="<%= problem.topic %>">
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="difficulty">Difficulty</label>
                <select id="difficulty" name="difficulty" class="form-select">
                  <% ["Easy","Medium","Hard"].forEach(d => { %>
                  <option value="<%= d %>" <%= problem.difficulty === d ? "selected" : "" %>><%= d %></option>
                  <% }) %>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="status">Status</label>
                <select id="status" name="status" class="form-select">
                  <% ["Todo","Solved","Needs Revision"].forEach(s => { %>
                  <option value="<%= s %>" <%= problem.status === s ? "selected" : "" %>><%= s %></option>
                  <% }) %>
                </select>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="solvedDate">Solved Date</label>
                <input type="date" id="solvedDate" name="solvedDate" class="form-control" value="<%= problem.solvedDate %>">
              </div>

              <div class="form-group">
                <label class="form-label" for="link">Problem URL</label>
                <input type="url" id="link" name="link" class="form-control" value="<%= problem.link %>">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="notes">Approach & Key Learnings</label>
              <textarea id="notes" name="notes" class="form-textarea"><%= problem.notes %></textarea>
            </div>

            <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
              <a href="/dsa" class="btn btn-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary">
                <i data-lucide="check"></i>
                <span>Update Problem</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
