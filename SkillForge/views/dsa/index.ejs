<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>DSA Tracker — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'dsa' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Data Structures & Algorithms Tracker' }) %>

      <div class="app-content animate-fade-in">
        <div class="page-header">
          <div>
            <h1 class="page-title">DSA & Problem Tracker</h1>
            <p class="page-subtitle">Track algorithm mastery, difficulty distributions, and daily practice streaks.</p>
          </div>
          <div class="page-actions">
            <a href="/dsa/add" class="btn btn-primary">
              <i data-lucide="plus"></i>
              <span>Log Problem</span>
            </a>
          </div>
        </div>

        <!-- DSA Stats Grid -->
        <div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); margin-bottom: 1.75rem;">
          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Total Solved</span>
              <div class="stat-icon-wrapper"><i data-lucide="check-circle-2"></i></div>
            </div>
            <div class="stat-value" style="color: var(--primary);"><%= stats.solved %></div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Easy</span>
              <div class="stat-icon-wrapper" style="background: var(--success-light); color: var(--success);"><i data-lucide="smile"></i></div>
            </div>
            <div class="stat-value" style="color: var(--success);"><%= stats.easy %></div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Medium</span>
              <div class="stat-icon-wrapper" style="background: var(--warning-light); color: var(--warning);"><i data-lucide="zap"></i></div>
            </div>
            <div class="stat-value" style="color: var(--warning);"><%= stats.medium %></div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Hard</span>
              <div class="stat-icon-wrapper" style="background: var(--danger-light); color: var(--danger);"><i data-lucide="flame"></i></div>
            </div>
            <div class="stat-value" style="color: var(--danger);"><%= stats.hard %></div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Practice Streak</span>
              <div class="stat-icon-wrapper" style="background: var(--accent-purple-light); color: var(--accent-purple);"><i data-lucide="trending-up"></i></div>
            </div>
            <div class="stat-value" style="color: var(--accent-purple);"><%= stats.streak %> Days</div>
          </div>
        </div>

        <% if (problems.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon"><i data-lucide="code-2" style="width: 32px; height: 32px;"></i></div>
          <h2 class="empty-state-title">No DSA Problems Logged</h2>
          <p class="empty-state-desc">Start logging your solved LeetCode or Codeforces questions to track your interview readiness.</p>
          <a href="/dsa/add" class="btn btn-primary"><i data-lucide="plus"></i> <span>Log First Problem</span></a>
        </div>
        <% } else { %>
        <div class="table-container">
          <table class="table">
            <thead>
              <tr>
                <th>Problem Title</th>
                <th>Topic</th>
                <th>Difficulty</th>
                <th>Status</th>
                <th style="text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% problems.forEach(p => { %>
              <tr>
                <td>
                  <div style="font-weight: 600; color: var(--text-primary);"><%= p.title %></div>
                  <span style="font-size: 0.75rem; color: var(--text-muted);"><%= p.platform || 'LeetCode' %></span>
                </td>
                <td>
                  <span class="badge badge-neutral"><%= p.topic || 'General' %></span>
                </td>
                <td>
                  <span class="badge <%= p.difficulty === 'Easy' ? 'badge-success' : (p.difficulty === 'Medium' ? 'badge-warning' : 'badge-danger') %>">
                    <%= p.difficulty %>
                  </span>
                </td>
                <td>
                  <span class="badge <%= p.status === 'Solved' ? 'badge-success' : (p.status === 'Needs Revision' ? 'badge-warning' : 'badge-neutral') %>">
                    <%= p.status %>
                  </span>
                </td>
                <td style="text-align: right;">
                  <div style="display: inline-flex; gap: 0.35rem;">
                    <% if (p.link) { %>
                    <a href="<%= p.link %>" target="_blank" class="btn btn-ghost btn-sm btn-icon" title="Problem Link">
                      <i data-lucide="external-link" style="width: 15px; height: 15px;"></i>
                    </a>
                    <% } %>
                    <a href="/dsa/edit/<%= p._id %>" class="btn btn-ghost btn-sm btn-icon" title="Edit Problem">
                      <i data-lucide="edit-2" style="width: 15px; height: 15px;"></i>
                    </a>
                    <form action="/dsa/delete/<%= p._id %>" method="POST" style="display: inline;" onsubmit="return confirm('Delete problem entry?')">
                      <button type="submit" class="btn btn-ghost btn-sm btn-icon" style="color: var(--danger) !important;" title="Delete">
                        <i data-lucide="trash-2" style="width: 15px; height: 15px;"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
