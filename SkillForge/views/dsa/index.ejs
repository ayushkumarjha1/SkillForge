<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DSA Tracker | SkillForge</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif;}
body{background:#f4f7fc;padding:40px;}
.container{max-width:1000px;margin:auto;}
.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;}
.add-btn{background:#4f46e5;color:white;padding:12px 24px;border-radius:10px;text-decoration:none;font-weight:600;}
.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:25px;}
.stat{background:white;padding:16px;border-radius:12px;text-align:center;box-shadow:0 8px 20px rgba(0,0,0,.06);}
.stat .num{font-size:22px;font-weight:700;color:#4f46e5;}
.stat .label{font-size:11px;color:#888;}
table{width:100%;border-collapse:collapse;background:white;border-radius:12px;overflow:hidden;box-shadow:0 8px 20px rgba(0,0,0,.06);}
th,td{padding:14px 16px;text-align:left;font-size:14px;}
th{background:#f8fafc;color:#666;font-size:12px;text-transform:uppercase;}
tr:not(:last-child) td{border-bottom:1px solid #eee;}
.diff{display:inline-block;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:600;}
.diff-Easy{background:#dcfce7;color:#16a34a;}
.diff-Medium{background:#fef9c3;color:#a16207;}
.diff-Hard{background:#fee2e2;color:#dc2626;}
.status{display:inline-block;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:600;background:#eef2ff;color:#4f46e5;}
.actions a,.actions button{margin-right:6px;font-size:12px;font-weight:600;text-decoration:none;border:none;background:none;color:#4f46e5;cursor:pointer;}
.empty{background:white;padding:60px;border-radius:15px;text-align:center;box-shadow:0 8px 20px rgba(0,0,0,.06);}
.back{display:block;margin-top:25px;text-align:center;text-decoration:none;color:#666;}
</style>
</head>
<body>
<div class="container">
<div class="header">
<h1>DSA Tracker</h1>
<a class="add-btn" href="/dsa/add">+ Add Problem</a>
</div>

<div class="stats">
<div class="stat"><div class="num"><%= stats.solved %></div><div class="label">Solved</div></div>
<div class="stat"><div class="num"><%= stats.easy %></div><div class="label">Easy</div></div>
<div class="stat"><div class="num"><%= stats.medium %></div><div class="label">Medium</div></div>
<div class="stat"><div class="num"><%= stats.hard %></div><div class="label">Hard</div></div>
<div class="stat"><div class="num"><%= stats.streak %></div><div class="label">Day Streak</div></div>
</div>

<% if (problems.length === 0) { %>
<div class="empty"><h2>No Problems Tracked Yet</h2><p>Log problems as you solve them to build your streak.</p></div>
<% } else { %>
<table>
<tr><th>Problem</th><th>Topic</th><th>Difficulty</th><th>Status</th><th></th></tr>
<% problems.forEach(p => { %>
<tr>
<td><%= p.title %> <span style="color:#aaa;font-size:12px;">(<%= p.platform %>)</span></td>
<td><%= p.topic || '-' %></td>
<td><span class="diff diff-<%= p.difficulty %>"><%= p.difficulty %></span></td>
<td><span class="status"><%= p.status %></span></td>
<td class="actions">
<a href="/dsa/edit/<%= p._id %>">Edit</a>
<% if (p.link) { %><a href="<%= p.link %>" target="_blank">Link</a><% } %>
<form action="/dsa/delete/<%= p._id %>" method="POST" style="display:inline" onsubmit="return confirm('Delete?')">
<button type="submit">Delete</button>
</form>
</td>
</tr>
<% }) %>
</table>
<% } %>

<a class="back" href="/dashboard">← Back to Dashboard</a>
</div>
</body>
</html>
