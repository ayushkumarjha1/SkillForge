<section class="landing-hero">
  <div class="hero-glow-bg"></div>

  <div class="hero-pill-badge">
    <i data-lucide="sparkles" class="sparkle-icon" style="width: 16px; height: 16px;"></i>
    <span>Powered by OpenRouter AI & Modern Tech Stack</span>
  </div>

  <h1 class="hero-title">
    The All-in-One AI Platform to <br>
    <span class="hero-gradient-text">Build, Track & Accelerate</span> Your Tech Career
  </h1>

  <p class="hero-desc">
    Master software engineering with intelligent AI career coaching, ATS-optimized resume engineering, live mock interviews, DSA problem tracker, and high-conversion job application Kanban.
  </p>

  <div class="hero-cta-group">
    <a href="/register" class="btn btn-primary btn-lg">
      <span>Get Started for Free</span>
      <i data-lucide="arrow-right" style="width: 18px; height: 18px;"></i>
    </a>
    <a href="/login" class="btn btn-secondary btn-lg">
      <i data-lucide="play-circle" style="width: 18px; height: 18px;"></i>
      <span>Sign In to Dashboard</span>
    </a>
  </div>

  <!-- Hero Interactive Showcase Mockup -->
  <div class="hero-mockup-wrapper animate-fade-in">
    <div class="hero-mockup-window">
      <div class="mockup-window-header">
        <span class="window-dot red"></span>
        <span class="window-dot yellow"></span>
        <span class="window-dot green"></span>
        <span style="font-size: 0.75rem; color: var(--text-muted); margin-left: 0.75rem; font-family: var(--font-mono);">skillforge.dev/dashboard</span>
      </div>
      <div class="mockup-window-body">
        <!-- Mockup Left Mini Sidebar -->
        <div style="border-right: 1px solid var(--border-subtle); padding-right: 1.25rem;">
          <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.75rem;">Workspace</div>
          <div style="display: flex; flex-direction: column; gap: 0.5rem;">
            <div style="padding: 0.5rem; background: var(--primary-light); color: var(--primary); border-radius: var(--radius-md); font-weight: 600; font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem;"><i data-lucide="layout-dashboard" style="width: 16px; height: 16px;"></i> Dashboard</div>
            <div style="padding: 0.5rem; color: var(--text-secondary); font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem;"><i data-lucide="folder-git-2" style="width: 16px; height: 16px;"></i> Projects</div>
            <div style="padding: 0.5rem; color: var(--text-secondary); font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem;"><i data-lucide="kanban" style="width: 16px; height: 16px;"></i> Jobs Board</div>
            <div style="padding: 0.5rem; color: var(--text-secondary); font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem;"><i data-lucide="sparkles" style="width: 16px; height: 16px; color: var(--primary);"></i> AI Coach</div>
          </div>
        </div>
        <!-- Mockup Right Dashboard Content -->
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
            <div>
              <h3 style="font-size: 1.2rem;">Welcome Back, Engineer 👋</h3>
              <p style="font-size: 0.825rem; color: var(--text-muted);">Your interview readiness score is up 14% this week.</p>
            </div>
            <span class="badge badge-success"><i data-lucide="trending-up" style="width: 12px; height: 12px;"></i> Job Ready</span>
          </div>

          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 1.5rem;">
            <div class="stat-card" style="padding: 1rem;">
              <span class="stat-label">Active Projects</span>
              <div class="stat-value" style="font-size: 1.75rem;">12</div>
            </div>
            <div class="stat-card" style="padding: 1rem;">
              <span class="stat-label">DSA Solved</span>
              <div class="stat-value" style="font-size: 1.75rem; color: var(--success);">148</div>
            </div>
            <div class="stat-card" style="padding: 1rem;">
              <span class="stat-label">ATS Score</span>
              <div class="stat-value" style="font-size: 1.75rem; color: var(--primary);">94%</div>
            </div>
          </div>

          <div class="card" style="padding: 1rem; border-left: 3px solid var(--primary);">
            <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; font-weight: 700; color: var(--primary); margin-bottom: 0.25rem;">
              <i data-lucide="sparkles" style="width: 14px; height: 14px;"></i> AI Career Insight
            </div>
            <p style="font-size: 0.8rem; color: var(--text-secondary); margin: 0;">"Consider adding a microservices or Redis caching project to strengthen your backend portfolio before Q3 recruitment."</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>