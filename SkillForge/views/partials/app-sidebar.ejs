      <div class="nav-section-title">System</div>
      <ul class="nav-list">
        <li class="nav-item">
          <a href="/notifications" class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'notifications') ? 'active' : '' %>">
            <span class="nav-icon"><i data-lucide="bell"></i></span>
            <span>Notifications</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/settings" class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'settings') ? 'active' : '' %>">
            <span class="nav-icon"><i data-lucide="settings"></i></span>
            <span>Settings</span>
          </a>
        </li>
