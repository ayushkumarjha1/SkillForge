<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Add Job Opportunity — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'jobs' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Log Job Opportunity' }) %>

      <div class="app-content animate-fade-in" style="max-width: 700px;">
        <div class="page-header">
          <div>
            <h1 class="page-title">Add Job Application</h1>
            <p class="page-subtitle">Track a new job opportunity in your pipeline.</p>
          </div>
          <div class="page-actions">
            <a href="/jobs" class="btn btn-secondary">
              <i data-lucide="arrow-left"></i>
              <span>Back to Kanban</span>
            </a>
          </div>
        </div>

        <div class="card">
          <form action="/jobs/add" method="POST">
            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="company">Company Name *</label>
                <input type="text" id="company" name="company" class="form-control" placeholder="e.g. Stripe, Google, Linear" required autofocus>
              </div>

              <div class="form-group">
                <label class="form-label" for="role">Job Role / Title</label>
                <input type="text" id="role" name="role" class="form-control" placeholder="e.g. Senior Frontend Engineer">
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="status">Pipeline Stage</label>
                <select id="status" name="status" class="form-select">
                  <% STAGES.forEach(s => { %>
                  <option value="<%= s %>"><%= s %></option>
                  <% }) %>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="location">Location</label>
                <input type="text" id="location" name="location" class="form-control" placeholder="e.g. Remote, San Francisco, NY">
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="salary">Compensation / Salary</label>
                <input type="text" id="salary" name="salary" class="form-control" placeholder="e.g. $140k - $170k / yr">
              </div>

              <div class="form-group">
                <label class="form-label" for="applyLink">Application / Job Post URL</label>
                <input type="url" id="applyLink" name="applyLink" class="form-control" placeholder="https://careers.company.com/job/123">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="notes">Notes & Interview Details</label>
              <textarea id="notes" name="notes" class="form-textarea" placeholder="Recruiter contact, referral names, interview rounds, prep questions..."></textarea>
            </div>

            <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
              <a href="/jobs" class="btn btn-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary">
                <i data-lucide="plus"></i>
                <span>Save Job</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
