<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= profileUser.fullName %> | SkillForge</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<% const isLight = profileUser.portfolioTheme === "Light"; %>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif;}
body{background:<%= isLight ? '#f4f7fc' : '#0f172a' %>;padding:40px;color:<%= isLight ? '#1e293b' : '#e2e8f0' %>;}
.container{max-width:800px;margin:auto;}
.badge{text-align:center;color:#94a3b8;font-size:13px;margin-bottom:20px;}
.card{background:<%= isLight ? '#ffffff' : '#1e293b' %>;padding:35px;border-radius:15px;margin-bottom:20px;<%= isLight ? 'box-shadow:0 8px 20px rgba(0,0,0,.06);' : '' %>}
.top{display:flex;gap:20px;align-items:center;}
.avatar{width:100px;height:100px;border-radius:50%;object-fit:cover;background:<%= isLight ? '#eef2ff' : '#334155' %>;}
.avatar-placeholder{width:100px;height:100px;border-radius:50%;background:<%= isLight ? '#eef2ff' : '#334155' %>;color:#6366f1;display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:700;}
h1{font-size:28px;margin-bottom:4px;color:<%= isLight ? '#111827' : '#fff' %>;}
.bio{color:<%= isLight ? '#64748b' : '#94a3b8' %>;}
h3{margin:0 0 12px;color:#6366f1;font-size:16px;}
.section p{color:<%= isLight ? '#334155' : '#cbd5e1' %>;line-height:1.6;}
.chips{display:flex;flex-wrap:wrap;gap:8px;}
.chip{background:<%= isLight ? '#eef2ff' : '#334155' %>;color:<%= isLight ? '#4f46e5' : '#c7d2fe' %>;padding:6px 14px;border-radius:20px;font-size:13px;font-weight:600;}
.entry{border-left:3px solid <%= isLight ? '#e2e8f0' : '#334155' %>;padding-left:15px;margin-bottom:15px;}
.entry .title{font-weight:600;color:<%= isLight ? '#111827' : '#fff' %>;}
.entry .meta{font-size:13px;color:#94a3b8;margin-bottom:4px;}
.links a{display:inline-block;margin-right:15px;color:#6366f1;font-weight:600;text-decoration:none;font-size:14px;}
.proj-link{font-size:12px;color:#6366f1;text-decoration:none;font-weight:600;}
</style>
</head>
<body>
<div class="container">

<p class="badge">Public SkillForge Profile</p>

<div class="card">
<div class="top">
<% if (profileUser.avatar) { %>
<img class="avatar" src="/uploads/avatars/<%= profileUser.avatar %>" alt="Avatar">
<% } else { %>
<div class="avatar-placeholder"><%= profileUser.fullName.charAt(0).toUpperCase() %></div>
<% } %>
<div>
<h1><%= profileUser.fullName %></h1>
<p class="bio"><%= profileUser.bio || '' %></p>
</div>
</div>
</div>

<% if (profileUser.about) { %>
<div class="card section">
<h3>About</h3>
<p><%= profileUser.about %></p>
</div>
<% } %>

<% if (profileUser.skills && profileUser.skills.length > 0) { %>
<div class="card section">
<h3>Skills</h3>
<div class="chips">
<% profileUser.skills.forEach(skill => { %><span class="chip"><%= skill %></span><% }) %>
</div>
</div>
<% } %>

<% if (profileUser.education && profileUser.education.length > 0) { %>
<div class="card section">
<h3>Education</h3>
<% profileUser.education.forEach(edu => { %>
<div class="entry">
<div class="title"><%= edu.institution %></div>
<div class="meta"><%= edu.degree %> <%= edu.field ? '· ' + edu.field : '' %> <%= (edu.startYear || edu.endYear) ? '· ' + edu.startYear + ' - ' + edu.endYear : '' %></div>
</div>
<% }) %>
</div>
<% } %>

<% if (profileUser.experience && profileUser.experience.length > 0) { %>
<div class="card section">
<h3>Experience</h3>
<% profileUser.experience.forEach(exp => { %>
<div class="entry">
<div class="title"><%= exp.role %> <%= exp.company ? '@ ' + exp.company : '' %></div>
<div class="meta"><%= exp.startDate %> - <%= exp.endDate %></div>
<p><%= exp.description %></p>
</div>
<% }) %>
</div>
<% } %>

<% if (featuredProjects && featuredProjects.length > 0) { %>
<div class="card section">
<h3>Featured Projects</h3>
<% featuredProjects.forEach(proj => { %>
<div class="entry">
<div class="title"><%= proj.title %></div>
<div class="meta"><%= proj.techStack %> <%= proj.category ? '· ' + proj.category : '' %></div>
<p><%= proj.description %></p>
<% if (proj.liveLink) { %><a class="proj-link" href="<%= proj.liveLink %>" target="_blank">Live Demo ↗</a><% } %>
<% if (proj.githubLink) { %> &nbsp; <a class="proj-link" href="<%= proj.githubLink %>" target="_blank">GitHub ↗</a><% } %>
</div>
<% }) %>
</div>
<% } %>

<% const hasLinks = profileUser.socialLinks && (profileUser.socialLinks.github || profileUser.socialLinks.linkedin || profileUser.socialLinks.twitter || profileUser.socialLinks.website) || profileUser.resumeLink || profileUser.portfolioLink; %>
<% if (hasLinks) { %>
<div class="card section links">
<h3>Links</h3>
<% if (profileUser.socialLinks.github) { %><a href="<%= profileUser.socialLinks.github %>" target="_blank">GitHub</a><% } %>
<% if (profileUser.socialLinks.linkedin) { %><a href="<%= profileUser.socialLinks.linkedin %>" target="_blank">LinkedIn</a><% } %>
<% if (profileUser.socialLinks.twitter) { %><a href="<%= profileUser.socialLinks.twitter %>" target="_blank">Twitter/X</a><% } %>
<% if (profileUser.socialLinks.website) { %><a href="<%= profileUser.socialLinks.website %>" target="_blank">Website</a><% } %>
<% if (profileUser.resumeLink) { %><a href="<%= profileUser.resumeLink %>" target="_blank">Resume</a><% } %>
<% if (profileUser.portfolioLink) { %><a href="<%= profileUser.portfolioLink %>" target="_blank">Portfolio</a><% } %>
</div>
<% } %>

</div>
</body>
</html>
