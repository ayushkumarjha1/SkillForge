<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title><%= profileUser.fullName %> — Developer Profile</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'profile' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Developer Profile' }) %>

      <div class="app-content animate-fade-in" style="max-width: 900px;">
        <div class="page-header">
          <div>
            <h1 class="page-title">Developer Profile</h1>
            <p class="page-subtitle">Your central identity, background story, skills, and portfolio connections.</p>
          </div>
          <div class="page-actions">
            <a href="/profile/edit" class="btn btn-primary">
              <i data-lucide="edit-2"></i>
              <span>Edit Profile</span>
            </a>
            <% if (profileUser.username) { %>
            <a href="/u/<%= profileUser.username %>" target="_blank" class="btn btn-secondary">
              <i data-lucide="external-link"></i>
              <span>Public View</span>
            </a>
            <% } %>
          </div>
        </div>

        <!-- Identity Card -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <div style="display: flex; gap: 1.5rem; align-items: center; flex-wrap: wrap;">
            <% if (profileUser.avatar) { %>
            <img src="/uploads/avatars/<%= profileUser.avatar %>" alt="<%= profileUser.fullName %>" style="width: 88px; height: 88px; border-radius: var(--radius-full); object-fit: cover; border: 2px solid var(--border-glow); box-shadow: var(--shadow-md);">
            <% } else { %>
            <div style="width: 88px; height: 88px; border-radius: var(--radius-full); background: linear-gradient(135deg, var(--primary), var(--accent-purple)); color: #fff; font-size: 2rem; font-weight: 800; display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-md);">
              <%= profileUser.fullName.charAt(0).toUpperCase() %>
            </div>
            <% } %>

            <div style="flex: 1; min-width: 240px;">
              <h2 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 0.25rem;"><%= profileUser.fullName %></h2>
              <p style="color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 0.5rem;"><%= profileUser.bio || 'No bio headline added yet.' %></p>
              <% if (profileUser.username) { %>
              <a href="/u/<%= profileUser.username %>" target="_blank" style="font-size: 0.825rem; color: var(--primary); font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem;">
                <span>skillforge.com/u/<%= profileUser.username %></span>
                <i data-lucide="external-link" style="width: 12px; height: 12px;"></i>
              </a>
              <% } %>
            </div>
          </div>
        </div>

        <!-- About Section -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <div class="card-header" style="margin-bottom: 0.75rem;">
            <h3 class="card-title" style="font-size: 1rem;"><i data-lucide="user"></i> About</h3>
          </div>
          <p style="color: var(--text-secondary); font-size: 0.925rem; line-height: 1.6; margin: 0;">
            <%= profileUser.about || 'No detailed background story written yet. Click Edit Profile to add one.' %>
          </p>
        </div>

        <!-- Skills Section -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <div class="card-header" style="margin-bottom: 0.75rem;">
            <h3 class="card-title" style="font-size: 1rem;"><i data-lucide="code-2"></i> Technical Skills</h3>
          </div>
          <% if (profileUser.skills && profileUser.skills.length > 0) { %>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            <% profileUser.skills.forEach(skill => { %>
            <span class="badge badge-primary" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;"><%= skill %></span>
            <% }) %>
          </div>
          <% } else { %>
          <p style="color: var(--text-muted); font-size: 0.875rem; margin: 0;">No skills added yet.</p>
          <% } %>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
          <!-- Education Section -->
          <div class="card">
            <div class="card-header" style="margin-bottom: 0.75rem;">
              <h3 class="card-title" style="font-size: 1rem;"><i data-lucide="graduation-cap"></i> Education</h3>
            </div>
            <% if (profileUser.education && profileUser.education.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
              <% profileUser.education.forEach(edu => { %>
              <div style="background: var(--bg-subtle); padding: 0.85rem; border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
                <div style="font-weight: 600; font-size: 0.95rem; color: var(--text-primary);"><%= edu.institution %></div>
                <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.2rem;">
                  <%= edu.degree %> <%= edu.field ? '· ' + edu.field : '' %>
                  <% if (edu.startYear || edu.endYear) { %> · <%= edu.startYear %> - <%= edu.endYear %><% } %>
                </div>
              </div>
              <% }) %>
            </div>
            <% } else { %>
            <p style="color: var(--text-muted); font-size: 0.875rem; margin: 0;">No education added yet.</p>
            <% } %>
          </div>

          <!-- Experience Section -->
          <div class="card">
            <div class="card-header" style="margin-bottom: 0.75rem;">
              <h3 class="card-title" style="font-size: 1rem;"><i data-lucide="briefcase"></i> Experience</h3>
            </div>
            <% if (profileUser.experience && profileUser.experience.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
              <% profileUser.experience.forEach(exp => { %>
              <div style="background: var(--bg-subtle); padding: 0.85rem; border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
                <div style="font-weight: 600; font-size: 0.95rem; color: var(--text-primary);"><%= exp.role %> <%= exp.company ? '@ ' + exp.company : '' %></div>
                <div style="font-size: 0.8rem; color: var(--text-muted); margin: 0.2rem 0 0.4rem 0;"><%= exp.startDate %> - <%= exp.endDate %></div>
                <% if (exp.description) { %>
                <p style="font-size: 0.85rem; color: var(--text-secondary); margin: 0;"><%= exp.description %></p>
                <% } %>
              </div>
              <% }) %>
            </div>
            <% } else { %>
            <p style="color: var(--text-muted); font-size: 0.875rem; margin: 0;">No experience added yet.</p>
            <% } %>
          </div>
        </div>

        <!-- Links Section -->
        <div class="card">
          <div class="card-header" style="margin-bottom: 0.75rem;">
            <h3 class="card-title" style="font-size: 1rem;"><i data-lucide="link"></i> Social & Portfolio Links</h3>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            <% const sl = profileUser.socialLinks || {}; %>
            <% if (sl.github) { %><a href="<%= sl.github %>" target="_blank" class="btn btn-secondary btn-sm"><i data-lucide="github"></i> <span>GitHub</span></a><% } %>
            <% if (sl.linkedin) { %><a href="<%= sl.linkedin %>" target="_blank" class="btn btn-secondary btn-sm"><i data-lucide="linkedin"></i> <span>LinkedIn</span></a><% } %>
            <% if (sl.twitter) { %><a href="<%= sl.twitter %>" target="_blank" class="btn btn-secondary btn-sm"><i data-lucide="twitter"></i> <span>Twitter / X</span></a><% } %>
            <% if (sl.website) { %><a href="<%= sl.website %>" target="_blank" class="btn btn-secondary btn-sm"><i data-lucide="globe"></i> <span>Personal Website</span></a><% } %>
            <% if (profileUser.resumeLink) { %><a href="<%= profileUser.resumeLink %>" target="_blank" class="btn btn-secondary btn-sm"><i data-lucide="file-text"></i> <span>External Resume</span></a><% } %>
            <% if (profileUser.portfolioLink) { %><a href="<%= profileUser.portfolioLink %>" target="_blank" class="btn btn-secondary btn-sm"><i data-lucide="briefcase"></i> <span>External Portfolio</span></a><% } %>
            <% if (!(sl.github || sl.linkedin || sl.twitter || sl.website) && !profileUser.resumeLink && !profileUser.portfolioLink) { %>
            <p style="color: var(--text-muted); font-size: 0.875rem; margin: 0;">No links configured.</p>
            <% } %>
          </div>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
