<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Edit Profile | SkillForge</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif;}
body{background:#f4f7fc;padding:40px;}
.container{max-width:800px;margin:auto;background:white;padding:35px;border-radius:15px;box-shadow:0 10px 25px rgba(0,0,0,.08);}
h1{margin-bottom:8px;}
.sub{color:#888;margin-bottom:25px;font-size:14px;}
h3{margin:25px 0 12px;color:#4f46e5;font-size:16px;}
label{display:block;font-size:13px;font-weight:600;color:#555;margin-bottom:6px;}
input,textarea,select{width:100%;padding:12px;margin-bottom:15px;border:1px solid #ccc;border-radius:8px;font-size:15px;}
textarea{resize:vertical;height:100px;}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.entry{border:1px dashed #ddd;padding:15px;border-radius:10px;margin-bottom:12px;position:relative;}
.remove-entry{position:absolute;top:10px;right:10px;background:#dc2626;color:white;border:none;border-radius:6px;padding:4px 10px;font-size:12px;cursor:pointer;}
.add-entry{background:#eef2ff;color:#4f46e5;border:none;padding:10px 16px;border-radius:8px;font-weight:600;cursor:pointer;margin-bottom:20px;}
.avatar-preview{width:90px;height:90px;border-radius:50%;object-fit:cover;margin-bottom:12px;display:block;}
button[type="submit"]{width:100%;padding:14px;background:#4f46e5;color:white;border:none;border-radius:8px;font-size:16px;font-weight:600;cursor:pointer;margin-top:10px;}
button[type="submit"]:hover{background:#4338ca;}
.back{display:block;margin-top:15px;text-align:center;text-decoration:none;color:#4f46e5;font-weight:600;}
</style>
</head>
<body>
<div class="container">

<h1>Edit Profile</h1>
<p class="sub">This information can power your public profile and, later, your resume and portfolio.</p>

<form action="/profile/edit" method="POST" enctype="multipart/form-data">

<% if (profileUser.avatar) { %>
<img class="avatar-preview" src="/uploads/avatars/<%= profileUser.avatar %>" alt="Current avatar">
<% } %>
<label>Profile photo</label>
<input type="file" name="avatar" accept="image/*">

<label>Public username (used in your profile link)</label>
<input type="text" name="username" value="<%= profileUser.username || '' %>" placeholder="e.g. ayush-jha">

<label>Short bio (max 160 characters)</label>
<input type="text" name="bio" maxlength="160" value="<%= profileUser.bio %>" placeholder="e.g. BTech CSE (AIML) student | Aspiring Full-Stack Developer">

<label>About</label>
<textarea name="about" placeholder="Tell recruiters about yourself..."><%= profileUser.about %></textarea>

<label>Skills (comma separated)</label>
<input type="text" name="skills" value="<%= (profileUser.skills || []).join(', ') %>" placeholder="JavaScript, Node.js, MongoDB, React">

<label>Languages (comma separated)</label>
<input type="text" name="languages" value="<%= (profileUser.languages || []).join(', ') %>" placeholder="English, Hindi">

<h3>Education</h3>
<div id="education-list">
<% const eduList = (profileUser.education && profileUser.education.length > 0) ? profileUser.education : [{}]; %>
<% eduList.forEach(edu => { %>
<div class="entry">
<button type="button" class="remove-entry" onclick="this.parentElement.remove()">Remove</button>
<label>Institution</label>
<input type="text" name="eduInstitution" value="<%= edu.institution || '' %>" placeholder="e.g. XYZ Institute of Technology">
<div class="row">
<div>
<label>Degree</label>
<input type="text" name="eduDegree" value="<%= edu.degree || '' %>" placeholder="B.Tech">
</div>
<div>
<label>Field</label>
<input type="text" name="eduField" value="<%= edu.field || '' %>" placeholder="CSE (AIML)">
</div>
</div>
<div class="row">
<div>
<label>Start Year</label>
<input type="text" name="eduStartYear" value="<%= edu.startYear || '' %>" placeholder="2022">
</div>
<div>
<label>End Year</label>
<input type="text" name="eduEndYear" value="<%= edu.endYear || '' %>" placeholder="2027">
</div>
</div>
</div>
<% }) %>
</div>
<button type="button" class="add-entry" onclick="addEducationRow()">+ Add Education</button>

<h3>Experience</h3>
<div id="experience-list">
<% const expList = (profileUser.experience && profileUser.experience.length > 0) ? profileUser.experience : []; %>
<% expList.forEach(exp => { %>
<div class="entry">
<button type="button" class="remove-entry" onclick="this.parentElement.remove()">Remove</button>
<label>Company / Organization</label>
<input type="text" name="expCompany" value="<%= exp.company || '' %>">
<div class="row">
<div>
<label>Role</label>
<input type="text" name="expRole" value="<%= exp.role || '' %>">
</div>
<div>
<label>Duration</label>
<input type="text" name="expStartDate" value="<%= exp.startDate || '' %>" placeholder="Start (e.g. Jun 2025)">
</div>
</div>
<label>End (or "Present")</label>
<input type="text" name="expEndDate" value="<%= exp.endDate || '' %>">
<label>Description</label>
<textarea name="expDescription"><%= exp.description || '' %></textarea>
</div>
<% }) %>
</div>
<button type="button" class="add-entry" onclick="addExperienceRow()">+ Add Experience</button>

<h3>Social & Links</h3>
<label>GitHub</label>
<input type="url" name="github" value="<%= profileUser.socialLinks ? profileUser.socialLinks.github : '' %>" placeholder="https://github.com/yourusername">
<label>LinkedIn</label>
<input type="url" name="linkedin" value="<%= profileUser.socialLinks ? profileUser.socialLinks.linkedin : '' %>" placeholder="https://linkedin.com/in/yourusername">
<label>Twitter / X</label>
<input type="url" name="twitter" value="<%= profileUser.socialLinks ? profileUser.socialLinks.twitter : '' %>">
<label>Personal Website</label>
<input type="url" name="website" value="<%= profileUser.socialLinks ? profileUser.socialLinks.website : '' %>">
<label>Resume Link</label>
<input type="url" name="resumeLink" value="<%= profileUser.resumeLink %>" placeholder="Link to hosted resume (until Resume Builder is ready)">
<label>Portfolio Link</label>
<input type="url" name="portfolioLink" value="<%= profileUser.portfolioLink %>" placeholder="Link to hosted portfolio (until Portfolio Builder is ready)">

<button type="submit">Save Profile</button>

</form>

<a class="back" href="/profile">← Back to Profile</a>

</div>

<script>
function addEducationRow(){
  const wrap = document.createElement('div');
  wrap.className = 'entry';
  wrap.innerHTML = `
    <button type="button" class="remove-entry" onclick="this.parentElement.remove()">Remove</button>
    <label>Institution</label>
    <input type="text" name="eduInstitution" placeholder="e.g. XYZ Institute of Technology">
    <div class="row">
      <div><label>Degree</label><input type="text" name="eduDegree" placeholder="B.Tech"></div>
      <div><label>Field</label><input type="text" name="eduField" placeholder="CSE (AIML)"></div>
    </div>
    <div class="row">
      <div><label>Start Year</label><input type="text" name="eduStartYear" placeholder="2022"></div>
      <div><label>End Year</label><input type="text" name="eduEndYear" placeholder="2027"></div>
    </div>`;
  document.getElementById('education-list').appendChild(wrap);
}

function addExperienceRow(){
  const wrap = document.createElement('div');
  wrap.className = 'entry';
  wrap.innerHTML = `
    <button type="button" class="remove-entry" onclick="this.parentElement.remove()">Remove</button>
    <label>Company / Organization</label>
    <input type="text" name="expCompany">
    <div class="row">
      <div><label>Role</label><input type="text" name="expRole"></div>
      <div><label>Duration</label><input type="text" name="expStartDate" placeholder="Start (e.g. Jun 2025)"></div>
    </div>
    <label>End (or "Present")</label>
    <input type="text" name="expEndDate">
    <label>Description</label>
    <textarea name="expDescription"></textarea>`;
  document.getElementById('experience-list').appendChild(wrap);
}
</script>

</body>
</html>
