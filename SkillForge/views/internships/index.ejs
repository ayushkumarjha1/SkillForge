<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Internship Tracker — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'internships' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Internships Tracker' }) %>

      <div class="app-content animate-fade-in">
        <div class="page-header">
          <div>
            <h1 class="page-title">Internships Tracker</h1>
            <p class="page-subtitle">Track applications, online assessments (OA), interviews, and offers.</p>
          </div>
          <div class="page-actions">
            <a href="/internships/add" class="btn btn-primary">
              <i data-lucide="plus"></i>
              <span>Add Internship</span>
            </a>
          </div>
        </div>

        <!-- Metrics Grid -->
        <div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 1.75rem;">
          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Total Tracked</span>
              <div class="stat-icon-wrapper"><i data-lucide="briefcase"></i></div>
            </div>
            <div class="stat-value"><%= stats.total %></div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Applied</span>
              <div class="stat-icon-wrapper" style="background: var(--info-light); color: var(--info);"><i data-lucide="send"></i></div>
            </div>
            <div class="stat-value" style="color: var(--info);"><%= stats.applied %></div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Interviews</span>
              <div class="stat-icon-wrapper" style="background: var(--warning-light); color: var(--warning);"><i data-lucide="calendar"></i></div>
            </div>
            <div class="stat-value" style="color: var(--warning);"><%= stats.interview %></div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Offers</span>
              <div class="stat-icon-wrapper" style="background: var(--success-light); color: var(--success);"><i data-lucide="award"></i></div>
            </div>
            <div class="stat-value" style="color: var(--success);"><%= stats.offer %></div>
          </div>
        </div>

        <% if (internships.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon"><i data-lucide="briefcase" style="width: 32px; height: 32px;"></i></div>
          <h2 class="empty-state-title">No Internships Tracked Yet</h2>
          <p class="empty-state-desc">Log your active internship applications and upcoming test deadlines to stay ahead.</p>
          <a href="/internships/add" class="btn btn-primary"><i data-lucide="plus"></i> <span>Add First Internship</span></a>
        </div>
        <% } else { %>
        <div class="table-container">
          <table class="table">
            <thead>
              <tr>
                <th>Company</th>
                <th>Role</th>
                <th>Status</th>
                <th>Deadline</th>
                <th style="text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% internships.forEach(i => { %>
              <tr>
                <td style="font-weight: 700; color: var(--text-primary);"><%= i.company %></td>
                <td><%= i.role || 'SDE Intern' %></td>
                <td>
                  <span class="badge <%= i.status === 'Offer' ? 'badge-success' : (i.status === 'Interview' ? 'badge-primary' : (i.status === 'Rejected' ? 'badge-danger' : (i.status === 'OA/Test' ? 'badge-warning' : 'badge-neutral'))) %>">
                    <%= i.status %>
                  </span>
                </td>
                <td style="color: var(--text-muted); font-size: 0.85rem;"><%= i.deadline || '—' %></td>
                <td style="text-align: right;">
                  <div style="display: inline-flex; gap: 0.35rem;">
                    <% if (i.applyLink) { %>
                    <a href="<%= i.applyLink %>" target="_blank" class="btn btn-ghost btn-sm btn-icon" title="Application Link">
                      <i data-lucide="external-link" style="width: 15px; height: 15px;"></i>
                    </a>
                    <% } %>
                    <a href="/internships/edit/<%= i._id %>" class="btn btn-ghost btn-sm btn-icon" title="Edit">
                      <i data-lucide="edit-2" style="width: 15px; height: 15px;"></i>
                    </a>
                    <form action="/internships/delete/<%= i._id %>" method="POST" style="display: inline;" onsubmit="return confirm('Delete this internship?')">
                      <button type="submit" class="btn btn-ghost btn-sm btn-icon" style="color: var(--danger) !important;" title="Delete">
                        <i data-lucide="trash-2" style="width: 15px; height: 15px;"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
