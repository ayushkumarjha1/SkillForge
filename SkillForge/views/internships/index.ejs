<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Internships | SkillForge</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif;}
body{background:#f4f7fc;padding:40px;}
.container{max-width:1000px;margin:auto;}
.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;}
.add-btn{background:#4f46e5;color:white;padding:12px 24px;border-radius:10px;text-decoration:none;font-weight:600;}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;margin-bottom:25px;}
.stat{background:white;padding:18px;border-radius:12px;text-align:center;box-shadow:0 8px 20px rgba(0,0,0,.06);}
.stat .num{font-size:26px;font-weight:700;color:#4f46e5;}
.stat .label{font-size:12px;color:#888;}
table{width:100%;border-collapse:collapse;background:white;border-radius:12px;overflow:hidden;box-shadow:0 8px 20px rgba(0,0,0,.06);}
th,td{padding:14px 16px;text-align:left;font-size:14px;}
th{background:#f8fafc;color:#666;font-size:12px;text-transform:uppercase;}
tr:not(:last-child) td{border-bottom:1px solid #eee;}
.status{display:inline-block;padding:5px 12px;border-radius:20px;font-size:12px;font-weight:600;}
.st-Applied{background:#eef2ff;color:#4f46e5;}
.st-OATest{background:#fef9c3;color:#a16207;}
.st-Interview{background:#dbeafe;color:#1d4ed8;}
.st-Offer{background:#dcfce7;color:#16a34a;}
.st-Rejected{background:#fee2e2;color:#dc2626;}
.st-Withdrawn{background:#f1f5f9;color:#64748b;}
.actions a,.actions button{margin-right:6px;font-size:12px;font-weight:600;text-decoration:none;border:none;background:none;color:#4f46e5;cursor:pointer;}
.empty{background:white;padding:60px;border-radius:15px;text-align:center;box-shadow:0 8px 20px rgba(0,0,0,.06);}
.back{display:block;margin-top:25px;text-align:center;text-decoration:none;color:#666;}
</style>
</head>
<body>
<div class="container">
<div class="header">
<h1>Internship Tracker</h1>
<a class="add-btn" href="/internships/add">+ Add Internship</a>
</div>

<div class="stats">
<div class="stat"><div class="num"><%= stats.total %></div><div class="label">Total</div></div>
<div class="stat"><div class="num"><%= stats.applied %></div><div class="label">Applied</div></div>
<div class="stat"><div class="num"><%= stats.interview %></div><div class="label">Interview</div></div>
<div class="stat"><div class="num"><%= stats.offer %></div><div class="label">Offers</div></div>
</div>

<% if (internships.length === 0) { %>
<div class="empty"><h2>No Internships Tracked Yet</h2><p>Add applications you're actively pursuing.</p></div>
<% } else { %>
<table>
<tr><th>Company</th><th>Role</th><th>Status</th><th>Deadline</th><th></th></tr>
<% internships.forEach(i => { const statusSlug = i.status.replace(/[^a-zA-Z]/g, ''); %>
<tr>
<td><%= i.company %></td>
<td><%= i.role %></td>
<td><span class="status st-<%= statusSlug %>"><%= i.status %></span></td>
<td><%= i.deadline || '-' %></td>
<td class="actions">
<a href="/internships/edit/<%= i._id %>">Edit</a>
<% if (i.applyLink) { %><a href="<%= i.applyLink %>" target="_blank">Link</a><% } %>
<form action="/internships/delete/<%= i._id %>" method="POST" style="display:inline" onsubmit="return confirm('Delete?')">
<button type="submit">Delete</button>
</form>
</td>
</tr>
<% }) %>
</table>
<% } %>

<a class="back" href="/dashboard">← Back to Dashboard</a>
</div>
</body>
</html>
