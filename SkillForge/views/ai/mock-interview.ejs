<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Mock Interview | SkillForge</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif;}
body{background:#f4f7fc;padding:40px;}
.container{max-width:700px;margin:auto;}
h1{margin-bottom:6px;}
.sub{color:#888;font-size:14px;margin-bottom:20px;}
.card{background:white;padding:28px;border-radius:14px;box-shadow:0 8px 20px rgba(0,0,0,.06);margin-bottom:20px;}
select,textarea{width:100%;padding:12px;margin-bottom:15px;border:1px solid #ccc;border-radius:8px;font-size:14px;}
textarea{resize:vertical;height:120px;}
button{background:#4f46e5;color:white;border:none;padding:14px 26px;border-radius:8px;font-weight:600;cursor:pointer;font-size:15px;}
.warn-box{background:#fef9c3;color:#a16207;padding:14px;border-radius:8px;font-size:13px;margin-bottom:15px;}
.error-box{background:#fee2e2;color:#dc2626;padding:14px;border-radius:8px;font-size:13px;margin-bottom:15px;}
.question-box{background:#eef2ff;color:#4f46e5;padding:16px;border-radius:10px;font-size:15px;font-weight:600;margin-bottom:15px;}
.result{white-space:pre-wrap;font-size:14px;line-height:1.7;color:#333;}
.back{display:block;margin-top:20px;text-align:center;text-decoration:none;color:#666;}
</style>
</head>
<body>
<div class="container">
<h1>AI Mock Interview</h1>
<p class="sub">Pick an interview type, answer the question, get scored feedback.</p>

<% if (!configured) { %>
<div class="warn-box">This feature needs an <code>ANTHROPIC_API_KEY</code> in your <code>.env</code> file. Get one at console.anthropic.com, add it, and restart the server.</div>
<% } %>

<% if (error) { %><div class="error-box"><%= error %></div><% } %>

<div class="card">
<form action="/ai/mock-interview/question" method="POST">
<select name="type">
<% TYPES.forEach(t => { %>
<option value="<%= t %>" <%= type === t ? "selected" : "" %>><%= t %> Interview</option>
<% }) %>
</select>
<button type="submit" <%= configured ? '' : 'disabled' %>>Get a Question</button>
</form>
</div>

<% if (question) { %>
<div class="card">
<div class="question-box"><%= question %></div>
<form action="/ai/mock-interview/answer" method="POST">
<input type="hidden" name="type" value="<%= type %>">
<input type="hidden" name="question" value="<%= question %>">
<textarea name="answer" placeholder="Type your answer here..." required></textarea>
<button type="submit" <%= configured ? '' : 'disabled' %>>Submit Answer for Feedback</button>
</form>
</div>
<% } %>

<% if (feedback) { %>
<div class="card">
<h3 style="margin-bottom:10px;font-size:15px;">Feedback</h3>
<div class="result"><%= feedback %></div>
</div>
<% } %>

<a class="back" href="/dashboard">← Back to Dashboard</a>
</div>
</body>
</html>
