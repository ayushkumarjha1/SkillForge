<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Notifications — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'notifications' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'System & Activity Notifications' }) %>

      <div class="app-content animate-fade-in" style="max-width: 800px;">
        <div class="page-header">
          <div>
            <h1 class="page-title">Notifications</h1>
            <p class="page-subtitle">Real-time alerts on your applications, project milestones, and certifications.</p>
          </div>
          <div class="page-actions">
            <% if (unreadCount > 0) { %>
            <form action="/notifications/read-all" method="POST">
              <button type="submit" class="btn btn-secondary btn-sm">
                <i data-lucide="check-check"></i>
                <span>Mark All Read</span>
              </button>
            </form>
            <% } %>
          </div>
        </div>

        <% if (notifications.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon"><i data-lucide="bell-off" style="width: 32px; height: 32px;"></i></div>
          <h2 class="empty-state-title">You're All Caught Up!</h2>
          <p class="empty-state-desc">You'll see activity alerts here when your job applications advance or new certificates are added.</p>
        </div>
        <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <% notifications.forEach(n => { %>
          <div class="card" style="padding: 1.25rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; border-left: <%= n.read ? '1px solid var(--border-subtle)' : '4px solid var(--primary)' %>; background: <%= n.read ? 'var(--bg-card)' : 'rgba(79, 70, 229, 0.03)' %>;">
            <div style="display: flex; align-items: flex-start; gap: 0.85rem;">
              <div class="stat-icon-wrapper" style="width: 32px; height: 32px; flex-shrink: 0; background: <%= n.type === 'success' ? 'var(--success-light)' : (n.type === 'warning' ? 'var(--warning-light)' : 'var(--primary-light)') %>; color: <%= n.type === 'success' ? 'var(--success)' : (n.type === 'warning' ? 'var(--warning)' : 'var(--primary)') %>;">
                <i data-lucide="<%= n.type === 'success' ? 'check-circle' : (n.type === 'warning' ? 'alert-triangle' : 'info') %>" style="width: 16px; height: 16px;"></i>
              </div>

              <div>
                <div style="font-size: 0.95rem; font-weight: <%= n.read ? '500' : '600' %>; color: var(--text-primary); margin-bottom: 0.25rem;">
                  <%= n.message %>
                </div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">
                  <%= new Date(n.createdAt).toLocaleString() %>
                </div>
              </div>
            </div>

            <div style="display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0;">
              <% if (n.link) { %>
              <a href="<%= n.link %>" class="btn btn-secondary btn-sm">
                <span>View</span>
              </a>
              <% } %>

              <% if (!n.read) { %>
              <form action="/notifications/read/<%= n._id %>" method="POST">
                <button type="submit" class="btn btn-ghost btn-sm btn-icon" title="Mark as Read">
                  <i data-lucide="check" style="width: 16px; height: 16px;"></i>
                </button>
              </form>
              <% } %>

              <form action="/notifications/delete/<%= n._id %>" method="POST">
                <button type="submit" class="btn btn-ghost btn-sm btn-icon" style="color: var(--danger) !important;" title="Delete">
                  <i data-lucide="trash-2" style="width: 16px; height: 16px;"></i>
                </button>
              </form>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
