<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Notifications | SkillForge</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif;}
body{background:#f4f7fc;padding:40px;}
.container{max-width:700px;margin:auto;}
.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;}
.mark-all{background:#eef2ff;color:#4f46e5;border:none;padding:10px 18px;border-radius:8px;font-weight:600;cursor:pointer;font-size:13px;}
.item{background:white;padding:16px 18px;border-radius:12px;box-shadow:0 6px 16px rgba(0,0,0,.05);margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;gap:12px;}
.item.unread{border-left:4px solid #4f46e5;}
.item .msg{font-size:14px;}
.item .time{font-size:11px;color:#999;margin-top:4px;}
.dot{width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:8px;}
.dot-info{background:#4f46e5;}
.dot-success{background:#16a34a;}
.dot-warning{background:#f59e0b;}
.item-actions{display:flex;gap:6px;flex-shrink:0;}
.item-actions a,.item-actions button{font-size:11px;font-weight:600;border:none;background:#f1f5f9;color:#4f46e5;padding:6px 10px;border-radius:6px;cursor:pointer;text-decoration:none;}
.empty{background:white;padding:60px;border-radius:15px;text-align:center;box-shadow:0 8px 20px rgba(0,0,0,.06);}
.back{display:block;margin-top:25px;text-align:center;text-decoration:none;color:#666;}
</style>
</head>
<body>
<div class="container">
<div class="header">
<h1>Notifications <% if (unreadCount > 0) { %>(<%= unreadCount %> unread)<% } %></h1>
<% if (unreadCount > 0) { %>
<form action="/notifications/read-all" method="POST"><button class="mark-all" type="submit">Mark all as read</button></form>
<% } %>
</div>

<% if (notifications.length === 0) { %>
<div class="empty"><h2>No Notifications Yet</h2><p>You'll see updates here as things happen — job stage moves, new certificates, and more.</p></div>
<% } else { %>
<% notifications.forEach(n => { %>
<div class="item <%= n.read ? '' : 'unread' %>">
<div>
<div class="msg"><span class="dot dot-<%= n.type %>"></span><%= n.message %></div>
<div class="time"><%= new Date(n.createdAt).toLocaleString() %></div>
</div>
<div class="item-actions">
<% if (n.link) { %><a href="<%= n.link %>">Open</a><% } %>
<% if (!n.read) { %>
<form action="/notifications/read/<%= n._id %>" method="POST"><button type="submit">Mark Read</button></form>
<% } %>
<form action="/notifications/delete/<%= n._id %>" method="POST"><button type="submit">Delete</button></form>
</div>
</div>
<% }) %>
<% } %>

<a class="back" href="/dashboard">← Back to Dashboard</a>
</div>
</body>
</html>
