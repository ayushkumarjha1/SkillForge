<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Account Settings — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'settings' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Account & Security Settings' }) %>

      <div class="app-content animate-fade-in" style="max-width: 750px;">
        <div class="page-header">
          <div>
            <h1 class="page-title">Settings</h1>
            <p class="page-subtitle">Manage your account credentials, security preferences, and data privacy.</p>
          </div>
        </div>

        <% if (error) { %>
        <div class="alert alert-danger">
          <i data-lucide="alert-circle" style="flex-shrink: 0; width: 20px; height: 20px;"></i>
          <span><%= error %></span>
        </div>
        <% } %>

        <% if (success) { %>
        <div class="alert alert-success">
          <i data-lucide="check-circle-2" style="flex-shrink: 0; width: 20px; height: 20px;"></i>
          <span><%= success %></span>
        </div>
        <% } %>

        <!-- Account Info Card -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <div class="card-header" style="margin-bottom: 1rem;">
            <h3 class="card-title" style="font-size: 1.05rem;"><i data-lucide="user"></i> Account Identity</h3>
          </div>
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <div style="display: flex; justify-content: space-between; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-subtle); font-size: 0.9rem;">
              <span style="color: var(--text-muted);">Full Name</span>
              <span style="font-weight: 600; color: var(--text-primary);"><%= profileUser.fullName %></span>
            </div>
            <div style="display: flex; justify-content: space-between; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-subtle); font-size: 0.9rem;">
              <span style="color: var(--text-muted);">Email Address</span>
              <span style="font-weight: 600; color: var(--text-primary);"><%= profileUser.email %></span>
            </div>
            <div style="display: flex; justify-content: space-between; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-subtle); font-size: 0.9rem;">
              <span style="color: var(--text-muted);">Platform Role</span>
              <span class="badge badge-primary"><%= profileUser.role %></span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.9rem;">
              <span style="color: var(--text-muted);">Member Since</span>
              <span style="color: var(--text-secondary);"><%= new Date(profileUser.createdAt).toLocaleDateString() %></span>
            </div>
          </div>
        </div>

        <!-- Security & Password Card -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <div class="card-header" style="margin-bottom: 1rem;">
            <h3 class="card-title" style="font-size: 1.05rem;"><i data-lucide="lock"></i> Change Password</h3>
          </div>
          <form action="/settings/password" method="POST">
            <div class="form-group">
              <label class="form-label" for="currentPassword">Current Password</label>
              <div style="position: relative;">
                <input type="password" id="currentPassword" name="currentPassword" class="form-control" placeholder="••••••••" required style="padding-right: 2.5rem;">
                <button type="button" onclick="togglePassword('currentPassword', this)" style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--text-muted); cursor: pointer; display: flex; align-items: center;">
                  <i data-lucide="eye" style="width: 16px; height: 16px;"></i>
                </button>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="newPassword">New Password (Min 6 chars)</label>
                <div style="position: relative;">
                  <input type="password" id="newPassword" name="newPassword" class="form-control" placeholder="••••••••" minlength="6" required style="padding-right: 2.5rem;">
                  <button type="button" onclick="togglePassword('newPassword', this)" style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--text-muted); cursor: pointer; display: flex; align-items: center;">
                    <i data-lucide="eye" style="width: 16px; height: 16px;"></i>
                  </button>
                </div>
              </div>

              <div class="form-group">
                <label class="form-label" for="confirmPassword">Confirm New Password</label>
                <div style="position: relative;">
                  <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="••••••••" minlength="6" required style="padding-right: 2.5rem;">
                  <button type="button" onclick="togglePassword('confirmPassword', this)" style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--text-muted); cursor: pointer; display: flex; align-items: center;">
                    <i data-lucide="eye" style="width: 16px; height: 16px;"></i>
                  </button>
                </div>
              </div>
            </div>

            <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
              <button type="submit" class="btn btn-primary">
                <i data-lucide="key"></i>
                <span>Update Password</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Danger Zone Card -->
        <div class="card" style="border-color: rgba(239, 68, 68, 0.4); background: rgba(239, 68, 68, 0.02);">
          <div class="card-header" style="margin-bottom: 0.75rem;">
            <h3 class="card-title" style="font-size: 1.05rem; color: var(--danger);"><i data-lucide="alert-octagon"></i> Danger Zone</h3>
          </div>
          <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1.25rem;">
            Deleting your account will permanently purge your profile, projects, resumes, certifications, DSA tracking entries, and internship pipelines. This operation cannot be reversed.
          </p>
          <form action="/settings/delete-account" method="POST" onsubmit="return confirm('WARNING: This action is permanent and cannot be undone. Are you sure you want to delete your entire account?')">
            <button type="submit" class="btn btn-danger">
              <i data-lucide="trash-2"></i>
              <span>Permanently Delete Account</span>
            </button>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>

  <script>
    function togglePassword(inputId, btn) {
      const input = document.getElementById(inputId);
      if (input.type === 'password') {
        input.type = 'text';
        btn.innerHTML = '<i data-lucide="eye-off" style="width: 16px; height: 16px;"></i>';
      } else {
        input.type = 'password';
        btn.innerHTML = '<i data-lucide="eye" style="width: 16px; height: 16px;"></i>';
      }
      if (window.lucide) window.lucide.createIcons();
    }
  </script>
</body>
</html>
