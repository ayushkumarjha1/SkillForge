<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Resumes | SkillForge</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif;}
body{background:#f4f7fc;padding:40px;}
.container{max-width:1000px;margin:auto;}
.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:30px;}
.header h1{font-size:34px;}
.new-btn{background:#4f46e5;color:white;border:none;padding:12px 24px;border-radius:10px;text-decoration:none;font-weight:600;cursor:pointer;font-size:15px;}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px;}
.card{background:white;padding:22px;border-radius:14px;box-shadow:0 8px 20px rgba(0,0,0,.06);}
.card h2{font-size:18px;margin-bottom:8px;}
.template-tag{display:inline-block;background:#eef2ff;color:#4f46e5;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:600;margin-bottom:12px;}
.score-bar{background:#eee;border-radius:20px;height:10px;overflow:hidden;margin-bottom:6px;}
.score-fill{height:100%;background:linear-gradient(90deg,#4f46e5,#16a34a);}
.score-label{font-size:12px;color:#888;margin-bottom:16px;}
.updated{font-size:12px;color:#aaa;margin-bottom:14px;}
.actions{display:flex;gap:8px;flex-wrap:wrap;}
.actions a{padding:8px 14px;border-radius:8px;text-decoration:none;font-size:13px;font-weight:600;}
.edit{background:#eef2ff;color:#4f46e5;}
.view{background:#111827;color:white;}
.delete{background:#fee2e2;color:#dc2626;}
.empty{background:white;padding:60px;border-radius:15px;text-align:center;box-shadow:0 8px 20px rgba(0,0,0,.06);}
.back{display:block;margin-top:25px;text-align:center;text-decoration:none;color:#666;}
</style>
</head>
<body>
<div class="container">

<div class="header">
<h1>My Resumes</h1>
<form action="/resume/create" method="POST">
<button type="submit" class="new-btn">+ New Resume (auto-fill from Profile & Projects)</button>
</form>
</div>

<% if (resumesWithScores.length === 0) { %>
<div class="empty">
<h2>No Resumes Yet</h2>
<p>Create one — it auto-imports your Profile info and recent Projects to save you typing.</p>
</div>
<% } else { %>
<div class="grid">
<% resumesWithScores.forEach(item => { const r = item.doc; %>
<div class="card">
<h2><%= r.title %></h2>
<div class="template-tag"><%= r.template %> Template</div>
<div class="score-bar"><div class="score-fill" style="width:<%= item.score %>%"></div></div>
<div class="score-label">Resume completeness: <%= item.score %>%</div>
<div class="updated">Updated <%= new Date(r.updatedAt).toLocaleDateString() %></div>
<div class="actions">
<a class="edit" href="/resume/<%= r._id %>/edit">Edit</a>
<a class="view" href="/resume/<%= r._id %>/view" target="_blank">View / Export PDF</a>
<a class="delete" href="/resume/<%= r._id %>/delete" onclick="return confirm('Delete this resume?')">Delete</a>
</div>
</div>
<% }) %>
</div>
<% } %>

<a class="back" href="/dashboard">← Back to Dashboard</a>

</div>
</body>
</html>
