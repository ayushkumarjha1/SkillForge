<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Edit <%= resume.title %> — SkillForge</title>
  <style>
    .resume-editor-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      align-items: start;
    }
    @media (max-width: 1024px) {
      .resume-editor-layout {
        grid-template-columns: 1fr;
      }
    }
    .resume-paper {
      background: #ffffff;
      color: #0f172a;
      padding: 2.5rem;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-xl);
      border: 1px solid var(--border-subtle);
      font-family: var(--font-sans);
    }
    .resume-paper h1 {
      font-size: 1.75rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 0.25rem;
      color: #0f172a;
    }
    .resume-paper .contact {
      font-size: 0.85rem;
      color: #64748b;
      margin-bottom: 1.25rem;
      font-weight: 500;
    }
    .resume-paper h4 {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--primary);
      border-bottom: 2px solid #e2e8f0;
      padding-bottom: 0.35rem;
      margin: 1.25rem 0 0.65rem 0;
      font-weight: 700;
    }
    .resume-paper p {
      font-size: 0.875rem;
      color: #334155;
      line-height: 1.5;
      margin-bottom: 0.5rem;
    }
    .resume-paper .item-title {
      font-weight: 700;
      font-size: 0.95rem;
      color: #0f172a;
    }
    .resume-paper .item-meta {
      font-size: 0.8rem;
      color: #64748b;
      margin-bottom: 0.35rem;
      font-weight: 500;
    }
    .resume-paper .skill-chip {
      display: inline-block;
      background: #f1f5f9;
      color: #1e293b;
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-xs);
      font-size: 0.8rem;
      font-weight: 600;
      margin: 0 0.35rem 0.35rem 0;
    }
    .editor-section-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--primary);
      margin: 1.5rem 0 0.75rem 0;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .editor-entry-card {
      background: var(--bg-subtle);
      border: 1px solid var(--border-subtle);
      padding: 1rem;
      border-radius: var(--radius-md);
      margin-bottom: 0.75rem;
      position: relative;
    }
    .remove-entry-btn {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      background: var(--danger-light);
      color: var(--danger);
      border: none;
      padding: 0.25rem 0.5rem;
      border-radius: var(--radius-xs);
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'resume' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Resume Workspace' }) %>

      <div class="app-content animate-fade-in">
        <div class="page-header">
          <div>
            <h1 class="page-title"><%= resume.title %></h1>
            <p class="page-subtitle">Real-time editable ATS resume document.</p>
          </div>
          <div class="page-actions">
            <span class="badge badge-primary" style="font-size: 0.85rem; padding: 0.4rem 0.85rem;">
              Completeness: <strong id="scoreDisplay" style="margin-left: 4px;"><%= score %></strong>%
            </span>
            <a href="/resume/<%= resume._id %>/view" target="_blank" class="btn btn-secondary">
              <i data-lucide="printer"></i>
              <span>Export PDF</span>
            </a>
            <a href="/resume" class="btn btn-ghost">Back</a>
          </div>
        </div>

        <div class="resume-editor-layout">
          <!-- Left Column: Form Controls -->
          <div class="card">
            <form id="resumeForm" action="/resume/<%= resume._id %>/edit" method="POST">
              <div class="form-grid">
                <div class="form-group">
                  <label class="form-label" for="f_title">Resume Document Title</label>
                  <input type="text" name="title" id="f_title" class="form-control" value="<%= resume.title %>" required>
                </div>
                <div class="form-group">
                  <label class="form-label" for="f_template">Template Theme</label>
                  <select name="template" id="f_template" class="form-select">
                    <option value="Modern" <%= resume.template === "Modern" ? "selected" : "" %>>Modern ATS</option>
                    <option value="Minimal" <%= resume.template === "Minimal" ? "selected" : "" %>>Minimalist Silicon</option>
                    <option value="Classic" <%= resume.template === "Classic" ? "selected" : "" %>>Classic Academic</option>
                  </select>
                </div>
              </div>

              <div class="editor-section-title">
                <i data-lucide="user" style="width: 16px; height: 16px;"></i>
                <span>Personal Contact Info</span>
              </div>
              <div class="form-grid">
                <div class="form-group">
                  <label class="form-label" for="f_fullName">Full Name</label>
                  <input type="text" name="fullName" id="f_fullName" class="form-control" value="<%= resume.fullName %>">
                </div>
                <div class="form-group">
                  <label class="form-label" for="f_email">Email</label>
                  <input type="email" name="contactEmail" id="f_email" class="form-control" value="<%= resume.contactEmail %>">
                </div>
              </div>

              <div class="form-grid">
                <div class="form-group">
                  <label class="form-label" for="f_phone">Phone</label>
                  <input type="text" name="contactPhone" id="f_phone" class="form-control" value="<%= resume.contactPhone %>">
                </div>
                <div class="form-group">
                  <label class="form-label" for="f_location">Location</label>
                  <input type="text" name="location" id="f_location" class="form-control" value="<%= resume.location %>">
                </div>
              </div>

              <div class="editor-section-title">
                <i data-lucide="file-text" style="width: 16px; height: 16px;"></i>
                <span>Executive Summary</span>
              </div>
              <div class="form-group">
                <textarea name="summary" id="f_summary" class="form-textarea" placeholder="2-3 impactful sentences highlighting your experience and specialties..."><%= resume.summary %></textarea>
              </div>

              <div class="editor-section-title">
                <i data-lucide="code-2" style="width: 16px; height: 16px;"></i>
                <span>Technical Skills & Certifications</span>
              </div>
              <div class="form-group">
                <label class="form-label" for="f_skills">Skills (Comma-Separated)</label>
                <input type="text" name="skills" id="f_skills" class="form-control" value="<%= (resume.skills || []).join(', ') %>">
              </div>
              <div class="form-group">
                <label class="form-label" for="f_certs">Certifications (Comma-Separated)</label>
                <input type="text" name="certifications" id="f_certs" class="form-control" value="<%= (resume.certifications || []).join(', ') %>">
              </div>

              <div class="editor-section-title">
                <i data-lucide="briefcase" style="width: 16px; height: 16px;"></i>
                <span>Work Experience</span>
              </div>
              <div id="experience-list">
                <% (resume.experience || []).forEach(exp => { %>
                <div class="editor-entry-card">
                  <button type="button" class="remove-entry-btn" onclick="this.parentElement.remove(); renderPreview();">Remove</button>
                  <input type="text" name="expCompany" class="form-control" style="margin-bottom: 0.5rem;" placeholder="Company Name" value="<%= exp.company %>">
                  <div class="form-grid" style="margin-bottom: 0.5rem;">
                    <input type="text" name="expRole" class="form-control" placeholder="Role / Title" value="<%= exp.role %>">
                    <input type="text" name="expStartDate" class="form-control" placeholder="Start Date" value="<%= exp.startDate %>">
                  </div>
                  <input type="text" name="expEndDate" class="form-control" style="margin-bottom: 0.5rem;" placeholder="End Date (or Present)" value="<%= exp.endDate %>">
                  <textarea name="expDescription" class="form-textarea" placeholder="Bullet points of achievements, metrics, technologies used..."><%= exp.description %></textarea>
                </div>
                <% }) %>
              </div>
              <button type="button" class="btn btn-secondary btn-sm" style="margin-bottom: 1.5rem;" onclick="addRow('experience-list', experienceTemplate)">
                <i data-lucide="plus"></i> Add Experience
              </button>

              <div class="editor-section-title">
                <i data-lucide="folder-git-2" style="width: 16px; height: 16px;"></i>
                <span>Key Projects</span>
              </div>
              <div id="projects-list">
                <% (resume.projects || []).forEach(p => { %>
                <div class="editor-entry-card">
                  <button type="button" class="remove-entry-btn" onclick="this.parentElement.remove(); renderPreview();">Remove</button>
                  <input type="text" name="projTitle" class="form-control" style="margin-bottom: 0.5rem;" placeholder="Project Title" value="<%= p.title %>">
                  <textarea name="projDescription" class="form-textarea" style="margin-bottom: 0.5rem;" placeholder="Description & Impact"><%= p.description %></textarea>
                  <div class="form-grid">
                    <input type="text" name="projTechStack" class="form-control" placeholder="Tech Stack" value="<%= p.techStack %>">
                    <input type="text" name="projLink" class="form-control" placeholder="Live / GitHub Link" value="<%= p.link %>">
                  </div>
                </div>
                <% }) %>
              </div>
              <button type="button" class="btn btn-secondary btn-sm" style="margin-bottom: 1.5rem;" onclick="addRow('projects-list', projectTemplate)">
                <i data-lucide="plus"></i> Add Project
              </button>

              <div class="editor-section-title">
                <i data-lucide="graduation-cap" style="width: 16px; height: 16px;"></i>
                <span>Education</span>
              </div>
              <div id="education-list">
                <% (resume.education || []).forEach(edu => { %>
                <div class="editor-entry-card">
                  <button type="button" class="remove-entry-btn" onclick="this.parentElement.remove(); renderPreview();">Remove</button>
                  <input type="text" name="eduInstitution" class="form-control" style="margin-bottom: 0.5rem;" placeholder="University / College" value="<%= edu.institution %>">
                  <div class="form-grid" style="margin-bottom: 0.5rem;">
                    <input type="text" name="eduDegree" class="form-control" placeholder="Degree (e.g. B.S.)" value="<%= edu.degree %>">
                    <input type="text" name="eduField" class="form-control" placeholder="Field of Study" value="<%= edu.fieldOfStudy %>">
                  </div>
                  <div class="form-grid">
                    <input type="text" name="eduStartYear" class="form-control" placeholder="Start Year" value="<%= edu.startYear %>">
                    <input type="text" name="eduEndYear" class="form-control" placeholder="Graduation Year" value="<%= edu.endYear %>">
                  </div>
                </div>
                <% }) %>
              </div>
              <button type="button" class="btn btn-secondary btn-sm" style="margin-bottom: 1.5rem;" onclick="addRow('education-list', educationTemplate)">
                <i data-lucide="plus"></i> Add Education
              </button>

              <div style="border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
                <button type="submit" class="btn btn-primary" style="width: 100%;">
                  <i data-lucide="save"></i>
                  <span>Save Changes</span>
                </button>
              </div>
            </form>
          </div>

          <!-- Right Column: Live Paper Preview -->
          <div style="position: sticky; top: 90px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-size: 0.85rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">
                Live Preview
              </span>
              <span class="badge badge-neutral">Auto-Refreshing</span>
            </div>
            <div id="previewDoc" class="resume-paper">
              <!-- Live preview injected by JS -->
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>

  <script>
    const educationTemplate = `
    <div class="editor-entry-card">
      <button type="button" class="remove-entry-btn" onclick="this.parentElement.remove(); renderPreview();">Remove</button>
      <input type="text" name="eduInstitution" class="form-control" style="margin-bottom: 0.5rem;" placeholder="University / College">
      <div class="form-grid" style="margin-bottom: 0.5rem;">
        <input type="text" name="eduDegree" class="form-control" placeholder="Degree">
        <input type="text" name="eduField" class="form-control" placeholder="Field of Study">
      </div>
      <div class="form-grid">
        <input type="text" name="eduStartYear" class="form-control" placeholder="Start Year">
        <input type="text" name="eduEndYear" class="form-control" placeholder="Graduation Year">
      </div>
    </div>`;

    const experienceTemplate = `
    <div class="editor-entry-card">
      <button type="button" class="remove-entry-btn" onclick="this.parentElement.remove(); renderPreview();">Remove</button>
      <input type="text" name="expCompany" class="form-control" style="margin-bottom: 0.5rem;" placeholder="Company Name">
      <div class="form-grid" style="margin-bottom: 0.5rem;">
        <input type="text" name="expRole" class="form-control" placeholder="Role / Title">
        <input type="text" name="expStartDate" class="form-control" placeholder="Start Date">
      </div>
      <input type="text" name="expEndDate" class="form-control" style="margin-bottom: 0.5rem;" placeholder="End Date">
      <textarea name="expDescription" class="form-textarea" placeholder="Bullet points of achievements..."></textarea>
    </div>`;

    const projectTemplate = `
    <div class="editor-entry-card">
      <button type="button" class="remove-entry-btn" onclick="this.parentElement.remove(); renderPreview();">Remove</button>
      <input type="text" name="projTitle" class="form-control" style="margin-bottom: 0.5rem;" placeholder="Project Title">
      <textarea name="projDescription" class="form-textarea" style="margin-bottom: 0.5rem;" placeholder="Description"></textarea>
      <div class="form-grid">
        <input type="text" name="projTechStack" class="form-control" placeholder="Tech Stack">
        <input type="text" name="projLink" class="form-control" placeholder="Link">
      </div>
    </div>`;

    function addRow(listId, template) {
      const wrap = document.createElement('div');
      wrap.innerHTML = template.trim();
      document.getElementById(listId).appendChild(wrap.firstChild);
      renderPreview();
    }

    function collectRows(containerId, fieldNames) {
      const container = document.getElementById(containerId);
      const entries = Array.from(container.querySelectorAll('.editor-entry-card'));
      return entries.map(entry => {
        const obj = {};
        fieldNames.forEach(name => {
          const el = entry.querySelector(`[name="${name}"]`);
          obj[name] = el ? el.value.trim() : '';
        });
        return obj;
      });
    }

    function esc(str) {
      const div = document.createElement('div');
      div.innerText = str || '';
      return div.innerHTML;
    }

    function renderPreview() {
      const fullName = document.getElementById('f_fullName').value;
      const email = document.getElementById('f_email').value;
      const phone = document.getElementById('f_phone').value;
      const location = document.getElementById('f_location').value;
      const summary = document.getElementById('f_summary').value;
      const skills = document.getElementById('f_skills').value.split(',').map(s => s.trim()).filter(Boolean);
      const certs = document.getElementById('f_certs').value.split(',').map(s => s.trim()).filter(Boolean);

      const education = collectRows('education-list', ['eduInstitution','eduDegree','eduField','eduStartYear','eduEndYear']);
      const experience = collectRows('experience-list', ['expCompany','expRole','expStartDate','expEndDate','expDescription']);
      const projects = collectRows('projects-list', ['projTitle','projDescription','projTechStack','projLink']);

      let html = `<h1>${esc(fullName) || 'Your Name'}</h1>`;
      html += `<div class="contact">${[email, phone, location].filter(Boolean).map(esc).join(' · ')}</div>`;

      if (summary.trim()) {
        html += `<h4>Summary</h4><p>${esc(summary)}</p>`;
      }

      if (skills.length) {
        html += `<h4>Skills</h4><div>${skills.map(s => `<span class="skill-chip">${esc(s)}</span>`).join('')}</div>`;
      }

      if (experience.some(e => e.expCompany)) {
        html += `<h4>Experience</h4>`;
        experience.filter(e => e.expCompany).forEach(e => {
          html += `<div class="item-title">${esc(e.expRole)} ${e.expCompany ? '@ ' + esc(e.expCompany) : ''}</div>`;
          html += `<div class="item-meta">${esc(e.expStartDate)} - ${esc(e.expEndDate)}</div>`;
          if (e.expDescription) html += `<p>${esc(e.expDescription)}</p>`;
        });
      }

      if (projects.some(p => p.projTitle)) {
        html += `<h4>Projects</h4>`;
        projects.filter(p => p.projTitle).forEach(p => {
          html += `<div class="item-title">${esc(p.projTitle)}</div>`;
          if (p.projTechStack) html += `<div class="item-meta">${esc(p.projTechStack)}</div>`;
          if (p.projDescription) html += `<p>${esc(p.projDescription)}</p>`;
        });
      }

      if (education.some(e => e.eduInstitution)) {
        html += `<h4>Education</h4>`;
        education.filter(e => e.eduInstitution).forEach(e => {
          html += `<div class="item-title">${esc(e.eduInstitution)}</div>`;
          html += `<div class="item-meta">${esc(e.eduDegree)} ${e.eduField ? '· ' + esc(e.eduField) : ''} ${(e.eduStartYear || e.eduEndYear) ? '· ' + esc(e.eduStartYear) + ' - ' + esc(e.eduEndYear) : ''}</div>`;
        });
      }

      if (certs.length) {
        html += `<h4>Certifications</h4><p>${certs.map(esc).join(' · ')}</p>`;
      }

      document.getElementById('previewDoc').innerHTML = html;

      let score = 0;
      if (fullName && email) score += 15;
      if (summary && summary.trim().length > 20) score += 15;
      if (skills.length >= 3) score += 20;
      if (education.some(e => e.eduInstitution)) score += 15;
      if (experience.some(e => e.expCompany)) score += 15;
      if (projects.some(p => p.projTitle)) score += 20;
      document.getElementById('scoreDisplay').innerText = score;
    }

    document.getElementById('resumeForm').addEventListener('input', renderPreview);
    renderPreview();
  </script>
</body>
</html>
