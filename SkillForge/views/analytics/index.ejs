<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Analytics | SkillForge</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif;}
body{background:#f4f7fc;padding:40px;}
.container{max-width:1100px;margin:auto;}
h1{margin-bottom:25px;}
.summary{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-bottom:25px;}
.summary .card{background:white;padding:16px;border-radius:12px;text-align:center;box-shadow:0 8px 20px rgba(0,0,0,.06);}
.summary .num{font-size:22px;font-weight:700;color:#4f46e5;}
.summary .label{font-size:11px;color:#888;}
.charts{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;}
.chart-card{background:white;padding:20px;border-radius:14px;box-shadow:0 8px 20px rgba(0,0,0,.06);}
.chart-card h3{font-size:14px;margin-bottom:12px;color:#333;}
.chart-card canvas{max-height:220px;}
.empty-note{color:#aaa;font-size:13px;text-align:center;padding:40px 0;}
.back{display:block;margin-top:25px;text-align:center;text-decoration:none;color:#666;}
</style>
</head>
<body>
<div class="container">
<h1>Analytics</h1>

<div class="summary">
<div class="card"><div class="num"><%= data.projects.total %></div><div class="label">Projects</div></div>
<div class="card"><div class="num"><%= data.dsa.solved %></div><div class="label">DSA Solved</div></div>
<div class="card"><div class="num"><%= data.learning.total %></div><div class="label">Learning Items</div></div>
<div class="card"><div class="num"><%= data.internships.total %></div><div class="label">Internships</div></div>
<div class="card"><div class="num"><%= data.jobs.total %></div><div class="label">Job Applications</div></div>
<div class="card"><div class="num"><%= data.certificates.total %></div><div class="label">Certificates</div></div>
</div>

<div class="charts">

<div class="chart-card">
<h3>Projects by Status</h3>
<% if (data.projects.total > 0) { %><canvas id="projectsChart"></canvas><% } else { %><p class="empty-note">No project data yet.</p><% } %>
</div>

<div class="chart-card">
<h3>DSA Problems Solved by Difficulty</h3>
<% if (data.dsa.solved > 0) { %><canvas id="dsaChart"></canvas><% } else { %><p class="empty-note">No solved problems yet.</p><% } %>
</div>

<div class="chart-card">
<h3>Learning Progress by Status</h3>
<% if (data.learning.total > 0) { %><canvas id="learningChart"></canvas><% } else { %><p class="empty-note">No learning items yet.</p><% } %>
</div>

<div class="chart-card">
<h3>Internship Applications by Status</h3>
<% if (data.internships.total > 0) { %><canvas id="internshipChart"></canvas><% } else { %><p class="empty-note">No internships tracked yet.</p><% } %>
</div>

<div class="chart-card">
<h3>Job Applications by Stage</h3>
<% if (data.jobs.total > 0) { %><canvas id="jobsChart"></canvas><% } else { %><p class="empty-note">No jobs tracked yet.</p><% } %>
</div>

<div class="chart-card">
<h3>Projects by Category</h3>
<% if (data.projects.total > 0) { %><canvas id="categoryChart"></canvas><% } else { %><p class="empty-note">No project data yet.</p><% } %>
</div>

</div>

<a class="back" href="/dashboard">← Back to Dashboard</a>
</div>

<script>
const palette = ['#4f46e5','#16a34a','#f59e0b','#dc2626','#0891b2','#9333ea','#64748b'];

function makeChart(id, labels, values, type) {
  const el = document.getElementById(id);
  if (!el) return;
  new Chart(el, {
    type: type || 'doughnut',
    data: {
      labels,
      datasets: [{ data: values, backgroundColor: palette }]
    },
    options: { responsive: true, plugins: { legend: { position: 'bottom', labels: { font: { size: 11 } } } } }
  });
}

const projectsByStatus = <%- JSON.stringify(data.projects.byStatus) %>;
makeChart('projectsChart', Object.keys(projectsByStatus), Object.values(projectsByStatus));

const dsaByDifficulty = <%- JSON.stringify(data.dsa.byDifficulty) %>;
makeChart('dsaChart', Object.keys(dsaByDifficulty), Object.values(dsaByDifficulty));

const learningByStatus = <%- JSON.stringify(data.learning.byStatus) %>;
makeChart('learningChart', Object.keys(learningByStatus), Object.values(learningByStatus));

const internshipsByStatus = <%- JSON.stringify(data.internships.byStatus) %>;
makeChart('internshipChart', Object.keys(internshipsByStatus), Object.values(internshipsByStatus));

const jobsByStatus = <%- JSON.stringify(data.jobs.byStatus) %>;
makeChart('jobsChart', Object.keys(jobsByStatus), Object.values(jobsByStatus));

const projectsByCategory = <%- JSON.stringify(data.projects.byCategory) %>;
makeChart('categoryChart', Object.keys(projectsByCategory), Object.values(projectsByCategory), 'bar');
</script>

</body>
</html>
