{
  "name": "SkillForge Development Environment",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "SkillForge App",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm install && cp -n .env.example .env || true",
  "postStartCommand": "npm run dev"
}
