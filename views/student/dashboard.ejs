<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Dashboard — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'dashboard' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Overview Dashboard' }) %>

      <div class="app-content animate-fade-in">
        <!-- Dashboard Welcome Header -->
        <div class="page-header" style="margin-bottom: 2rem;">
          <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
              <span class="badge badge-primary" style="font-size: 0.75rem; padding: 0.2rem 0.6rem;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 3px;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                Developer Hub
              </span>
              <span style="font-size: 0.8rem; color: var(--text-muted);">Real-time Telemetry</span>
            </div>
            <h1 class="page-title" style="font-size: 1.85rem; font-weight: 800; letter-spacing: -0.03em;">
              Welcome back, <%= user.fullName %> 👋
            </h1>
            <p class="page-subtitle" style="font-size: 0.95rem;">
              Track your portfolio repositories, DSA streaks, job applications, and AI career guidance.
            </p>
          </div>
          <div class="page-actions">
            <a href="/projects/add" class="btn btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <span>New Project</span>
            </a>
            <a href="/ai/coach" class="btn btn-secondary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>
              <span>Ask AI Coach</span>
            </a>
          </div>
        </div>

        <!-- 4 Primary KPI Metrics Grid -->
        <div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
          <!-- Total Projects -->
          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Total Projects</span>
              <div class="stat-icon-wrapper" style="background: rgba(99, 102, 241, 0.15); color: #6366f1;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/><circle cx="12" cy="13" r="2"/></svg>
              </div>
            </div>
            <div class="stat-value"><%= totalProjects %></div>
            <div style="display: flex; align-items: center; gap: 0.4rem; margin-top: 0.5rem; font-size: 0.8rem; color: var(--text-muted);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
              <span>Portfolio Repositories</span>
            </div>
          </div>

          <!-- In Progress Projects -->
          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">In Progress</span>
              <div class="stat-icon-wrapper" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
            </div>
            <div class="stat-value" style="color: #f59e0b;"><%= progressProjects %></div>
            <div style="display: flex; align-items: center; gap: 0.4rem; margin-top: 0.5rem; font-size: 0.8rem; color: var(--text-muted);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              <span>Active Development</span>
            </div>
          </div>

          <!-- Completed Projects -->
          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Completed</span>
              <div class="stat-icon-wrapper" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </div>
            </div>
            <div class="stat-value" style="color: #10b981;"><%= completedProjects %></div>
            <div style="display: flex; align-items: center; gap: 0.4rem; margin-top: 0.5rem; font-size: 0.8rem; color: var(--text-muted);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              <span>Production Verified</span>
            </div>
          </div>

          <!-- Planning Stage -->
          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Planning Stage</span>
              <div class="stat-icon-wrapper" style="background: rgba(139, 92, 246, 0.15); color: #8b5cf6;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
              </div>
            </div>
            <div class="stat-value" style="color: #8b5cf6;"><%= planningProjects %></div>
            <div style="display: flex; align-items: center; gap: 0.4rem; margin-top: 0.5rem; font-size: 0.8rem; color: var(--text-muted);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              <span>Architecting Specs</span>
            </div>
          </div>
        </div>

        <!-- Secondary Highlights: DSA Streak & Live Pipeline Cards -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
          <!-- AI Suite Card -->
          <div class="card card-hover" style="background: linear-gradient(135deg, rgba(79, 70, 229, 0.08) 0%, rgba(139, 92, 246, 0.1) 100%); border-color: rgba(99, 102, 241, 0.3);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
              <span class="badge badge-primary">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>
                AI Career Copilot
              </span>
              <span style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono);">OpenRouter</span>
            </div>
            <h3 style="margin-bottom: 0.5rem; font-size: 1.25rem; font-weight: 700;">Intelligent Career Suite</h3>
            <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 1.25rem; line-height: 1.5;">
              Audit resume ATS keywords, practice interactive voice mock interviews, and receive tailored 30-60-90 day engineering roadmaps.
            </p>
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
              <a href="/ai/coach" class="btn btn-primary btn-sm">Ask AI Coach</a>
              <a href="/ai/resume-analyzer" class="btn btn-secondary btn-sm">Resume ATS Check</a>
              <a href="/ai/mock-interview" class="btn btn-secondary btn-sm">Mock Interview</a>
            </div>
          </div>

          <!-- Career Pipeline Card -->
          <div class="card card-hover">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
              <span class="badge badge-neutral">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
                Opportunity Pipeline
              </span>
              <span class="badge badge-success"><%= activeJobsCount %> Active Applications</span>
            </div>
            <h3 style="margin-bottom: 0.5rem; font-size: 1.25rem; font-weight: 700;">Job & Internship Kanban</h3>
            <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 1.25rem; line-height: 1.5;">
              Manage your application stages, upcoming interviews, compensation packages, and offer deadlines in one cohesive board.
            </p>
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
              <a href="/jobs" class="btn btn-primary btn-sm">Open Kanban Board</a>
              <a href="/internships" class="btn btn-secondary btn-sm">Internships</a>
              <a href="/resume" class="btn btn-secondary btn-sm">Resume Studio</a>
            </div>
          </div>
        </div>

        <!-- Recent Projects & Skill Highlights -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
          <!-- Recent Projects Widget -->
          <div class="card">
            <div class="card-header" style="margin-bottom: 1rem;">
              <div class="card-title" style="font-size: 1.05rem;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg>
                <span>Recent Projects</span>
              </div>
              <a href="/projects" style="font-size: 0.8rem; color: var(--primary); text-decoration: none; font-weight: 600;">View All &rarr;</a>
            </div>

            <% if (recentProjects && recentProjects.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
              <% recentProjects.forEach(proj => { %>
              <a href="/projects/edit/<%= proj._id %>" style="text-decoration: none; display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; background: var(--bg-subtle); border-radius: var(--radius-md); border: 1px solid var(--border-subtle); transition: all 0.2s ease;">
                <div>
                  <div style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary);"><%= proj.title %></div>
                  <div style="font-size: 0.75rem; color: var(--text-muted);"><%= proj.techStack || 'Fullstack' %></div>
                </div>
                <span class="badge <%= proj.status === 'Completed' ? 'badge-success' : proj.status === 'In Progress' ? 'badge-warning' : 'badge-neutral' %>" style="font-size: 0.75rem;">
                  <%= proj.status %>
                </span>
              </a>
              <% }) %>
            </div>
            <% } else { %>
            <div style="text-align: center; padding: 2rem 1rem; color: var(--text-muted);">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 0.5rem; opacity: 0.5;"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg>
              <p style="font-size: 0.9rem; margin-bottom: 0.75rem;">No projects created yet.</p>
              <a href="/projects/add" class="btn btn-primary btn-sm">+ Add First Project</a>
            </div>
            <% } %>
          </div>

          <!-- Quick Skills & Progress Widget -->
          <div class="card">
            <div class="card-header" style="margin-bottom: 1rem;">
              <div class="card-title" style="font-size: 1.05rem;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span>Skill Forge Metrics</span>
              </div>
              <a href="/analytics" style="font-size: 0.8rem; color: var(--primary); text-decoration: none; font-weight: 600;">Analytics &rarr;</a>
            </div>

            <div style="display: flex; flex-direction: column; gap: 1rem;">
              <!-- DSA Progress Bar -->
              <div>
                <div style="display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 0.4rem;">
                  <span style="font-weight: 600; color: var(--text-primary);">DSA Problem Solving</span>
                  <span style="color: #10b981; font-weight: 700;"><%= dsaSolvedCount %> Solved</span>
                </div>
                <div style="width: 100%; height: 8px; background: var(--bg-subtle); border-radius: 4px; overflow: hidden;">
                  <div style="width: <%= dsaTotalCount > 0 ? Math.min(Math.round((dsaSolvedCount / dsaTotalCount) * 100), 100) : (dsaSolvedCount > 0 ? 100 : 5) %>%; height: 100%; background: linear-gradient(90deg, #10b981 0%, #06b6d4 100%); border-radius: 4px;"></div>
                </div>
              </div>

              <!-- Learning Hub Items -->
              <div>
                <div style="display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 0.4rem;">
                  <span style="font-weight: 600; color: var(--text-primary);">Learning Modules</span>
                  <span style="color: #8b5cf6; font-weight: 700;"><%= learningItemsCount %> In Progress</span>
                </div>
                <div style="width: 100%; height: 8px; background: var(--bg-subtle); border-radius: 4px; overflow: hidden;">
                  <div style="width: <%= Math.min(learningItemsCount * 20, 100) || 5 %>%; height: 100%; background: linear-gradient(90deg, #8b5cf6 0%, #ec4899 100%); border-radius: 4px;"></div>
                </div>
              </div>

              <!-- Verified Certificates -->
              <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.5rem; border-top: 1px solid var(--border-subtle); font-size: 0.85rem;">
                <span style="color: var(--text-muted);">Verified Certificates</span>
                <span class="badge badge-primary"><%= certificatesCount %> Credentials</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Jump Links Grid -->
        <div class="card">
          <div class="card-header" style="margin-bottom: 1rem;">
            <div class="card-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              <span>Quick Actions & Shortcuts</span>
            </div>
          </div>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem;">
            <a href="/projects" class="card card-hover" style="padding: 1rem; text-decoration: none; display: flex; align-items: center; gap: 0.75rem;">
              <div class="stat-icon-wrapper" style="width: 38px; height: 38px; background: rgba(99, 102, 241, 0.15); color: #6366f1;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg>
              </div>
              <div>
                <div style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary);">Projects Hub</div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">Manage repositories</div>
              </div>
            </a>

            <a href="/dsa" class="card card-hover" style="padding: 1rem; text-decoration: none; display: flex; align-items: center; gap: 0.75rem;">
              <div class="stat-icon-wrapper" style="width: 38px; height: 38px; background: rgba(16, 185, 129, 0.15); color: #10b981;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
              </div>
              <div>
                <div style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary);">DSA Tracker</div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">Log LeetCode streaks</div>
              </div>
            </a>

            <a href="/learning" class="card card-hover" style="padding: 1rem; text-decoration: none; display: flex; align-items: center; gap: 0.75rem;">
              <div class="stat-icon-wrapper" style="width: 38px; height: 38px; background: rgba(139, 92, 246, 0.15); color: #8b5cf6;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              </div>
              <div>
                <div style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary);">Learning Hub</div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">Courses & roadmaps</div>
              </div>
            </a>

            <a href="/github" class="card card-hover" style="padding: 1rem; text-decoration: none; display: flex; align-items: center; gap: 0.75rem;">
              <div class="stat-icon-wrapper" style="width: 38px; height: 38px; background: rgba(6, 182, 212, 0.15); color: #06b6d4;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
              </div>
              <div>
                <div style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary);">GitHub Insights</div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">Sync repository stats</div>
              </div>
            </a>
          </div>
        </div>

      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>