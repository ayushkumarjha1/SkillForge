<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Edit Project — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'projects' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Edit Project' }) %>

      <div class="app-content animate-fade-in" style="max-width: 800px;">
        <div class="page-header">
          <div>
            <h1 class="page-title">Edit Project</h1>
            <p class="page-subtitle">Update details, repositories, and status for "<%= project.title %>".</p>
          </div>
          <div class="page-actions">
            <a href="/projects" class="btn btn-secondary">
              <i data-lucide="arrow-left"></i>
              <span>Back to Projects</span>
            </a>
          </div>
        </div>

        <div class="card">
          <form action="/projects/edit/<%= project._id %>" method="POST" enctype="multipart/form-data">
            <div class="form-group">
              <label class="form-label" for="title">Project Title *</label>
              <input type="text" id="title" name="title" class="form-control" value="<%= project.title %>" required>
            </div>

            <div class="form-group">
              <label class="form-label" for="description">Description *</label>
              <textarea id="description" name="description" class="form-textarea" required><%= project.description %></textarea>
            </div>

            <div class="form-group">
              <label class="form-label" for="techStack">Tech Stack *</label>
              <input type="text" id="techStack" name="techStack" class="form-control" value="<%= project.techStack %>" required>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="githubLink">GitHub Repository URL</label>
                <input type="url" id="githubLink" name="githubLink" class="form-control" value="<%= project.githubLink %>">
              </div>

              <div class="form-group">
                <label class="form-label" for="liveLink">Live Demo URL</label>
                <input type="url" id="liveLink" name="liveLink" class="form-control" value="<%= project.liveLink %>">
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="status">Project Status</label>
                <select id="status" name="status" class="form-select">
                  <option value="Planning" <%= project.status === "Planning" ? "selected" : "" %>>Planning</option>
                  <option value="In Progress" <%= project.status === "In Progress" ? "selected" : "" %>>In Progress</option>
                  <option value="Completed" <%= project.status === "Completed" ? "selected" : "" %>>Completed</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="category">Category</label>
                <select id="category" name="category" class="form-select">
                  <% ["Web App","Mobile App","AI/ML","Data Science","Game Dev","DevOps/Tools","Other"].forEach(cat => { %>
                  <option value="<%= cat %>" <%= project.category === cat ? "selected" : "" %>><%= cat %></option>
                  <% }) %>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="tags">Tags (Comma-Separated)</label>
              <input type="text" id="tags" name="tags" class="form-control" value="<%= (project.tags || []).join(', ') %>">
            </div>

            <% if (project.coverImage) { %>
            <div class="form-group">
              <label class="form-label">Current Cover Image</label>
              <div style="max-width: 240px; height: 130px; border-radius: var(--radius-md); overflow: hidden; margin-bottom: 0.5rem;">
                <img src="/uploads/covers/<%= project.coverImage %>" alt="Current Cover" style="width: 100%; height: 100%; object-fit: cover;">
              </div>
            </div>
            <% } %>

            <div class="form-group">
              <label class="form-label" for="coverImage">Replace Cover Image</label>
              <input type="file" id="coverImage" name="coverImage" class="form-control" accept="image/*">
              <small class="form-hint">Leave empty to keep your existing cover photo.</small>
            </div>

            <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
              <a href="/projects" class="btn btn-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary">
                <i data-lucide="check"></i>
                <span>Update Project</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>