<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Edit Internship — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'internships' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Edit Internship' }) %>

      <div class="app-content animate-fade-in" style="max-width: 700px;">
        <div class="page-header">
          <div>
            <h1 class="page-title">Edit Internship</h1>
            <p class="page-subtitle">Update details for <%= internship.company %>.</p>
          </div>
          <div class="page-actions">
            <a href="/internships" class="btn btn-secondary">
              <i data-lucide="arrow-left"></i>
              <span>Back to Internships</span>
            </a>
          </div>
        </div>

        <div class="card">
          <form action="/internships/edit/<%= internship._id %>" method="POST">
            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="company">Company Name *</label>
                <input type="text" id="company" name="company" class="form-control" value="<%= internship.company %>" required>
              </div>

              <div class="form-group">
                <label class="form-label" for="role">Role / Program Title</label>
                <input type="text" id="role" name="role" class="form-control" value="<%= internship.role %>">
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="status">Application Status</label>
                <select id="status" name="status" class="form-select">
                  <% ["Applied","OA/Test","Interview","Offer","Rejected","Withdrawn"].forEach(s => { %>
                  <option value="<%= s %>" <%= internship.status === s ? "selected" : "" %>><%= s %></option>
                  <% }) %>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="deadline">Deadline</label>
                <input type="text" id="deadline" name="deadline" class="form-control" value="<%= internship.deadline %>">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="applyLink">Application Link</label>
              <input type="url" id="applyLink" name="applyLink" class="form-control" value="<%= internship.applyLink %>">
            </div>

            <div class="form-group">
              <label class="form-label" for="notes">Notes & Prep Topics</label>
              <textarea id="notes" name="notes" class="form-textarea"><%= internship.notes %></textarea>
            </div>

            <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
              <a href="/internships" class="btn btn-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary">
                <i data-lucide="check"></i>
                <span>Update Internship</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
