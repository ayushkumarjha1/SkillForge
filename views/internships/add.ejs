<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Add Internship — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'internships' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Log Internship' }) %>

      <div class="app-content animate-fade-in" style="max-width: 700px;">
        <div class="page-header">
          <div>
            <h1 class="page-title">Add Internship Opportunity</h1>
            <p class="page-subtitle">Track a new internship application and its progress.</p>
          </div>
          <div class="page-actions">
            <a href="/internships" class="btn btn-secondary">
              <i data-lucide="arrow-left"></i>
              <span>Back to Internships</span>
            </a>
          </div>
        </div>

        <div class="card">
          <form action="/internships/add" method="POST">
            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="company">Company Name *</label>
                <input type="text" id="company" name="company" class="form-control" placeholder="e.g. Microsoft, Uber, Amazon" required autofocus>
              </div>

              <div class="form-group">
                <label class="form-label" for="role">Role / Program Title</label>
                <input type="text" id="role" name="role" class="form-control" placeholder="e.g. Software Engineering Intern">
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="status">Application Status</label>
                <select id="status" name="status" class="form-select">
                  <option value="Applied">Applied</option>
                  <option value="OA/Test">OA/Test</option>
                  <option value="Interview">Interview</option>
                  <option value="Offer">Offer</option>
                  <option value="Rejected">Rejected</option>
                  <option value="Withdrawn">Withdrawn</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="deadline">Application / Test Deadline</label>
                <input type="text" id="deadline" name="deadline" class="form-control" placeholder="e.g. Sept 15, 2026">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="applyLink">Application / Portal Link</label>
              <input type="url" id="applyLink" name="applyLink" class="form-control" placeholder="https://careers.company.com/internships">
            </div>

            <div class="form-group">
              <label class="form-label" for="notes">Notes & Prep Topics</label>
              <textarea id="notes" name="notes" class="form-textarea" placeholder="Assessment link, OA test score, referral info, recruiter email..."></textarea>
            </div>

            <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
              <a href="/internships" class="btn btn-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary">
                <i data-lucide="plus"></i>
                <span>Save Internship</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
