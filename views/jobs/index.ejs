<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Job Tracker Kanban — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'jobs' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Job Applications Kanban' }) %>

      <div class="app-content animate-fade-in">
        <div class="page-header">
          <div>
            <h1 class="page-title">Job Application Pipeline</h1>
            <p class="page-subtitle">Track opportunities from wishlist to signed offer with deadline management.</p>
          </div>
          <div class="page-actions">
            <a href="/jobs/add" class="btn btn-primary">
              <i data-lucide="plus"></i>
              <span>Add Job Opportunity</span>
            </a>
          </div>
        </div>

        <!-- Kanban Board -->
        <div class="kanban-board">
          <% board.forEach((col, colIndex) => { %>
          <div class="kanban-column">
            <div class="kanban-col-header">
              <span class="kanban-col-title">
                <span style="width: 8px; height: 8px; border-radius: var(--radius-full); background: <%= colIndex === 0 ? 'var(--text-muted)' : (colIndex === 1 ? 'var(--info)' : (colIndex === 2 ? 'var(--warning)' : (colIndex === 3 ? 'var(--success)' : 'var(--danger)'))) %>;"></span>
                <span><%= col.stage %></span>
              </span>
              <span class="kanban-col-count"><%= col.jobs.length %></span>
            </div>

            <div class="kanban-cards-list">
              <% if (col.jobs.length === 0) { %>
              <div style="text-align: center; padding: 2rem 0.5rem; color: var(--text-muted); font-size: 0.825rem;">
                No jobs in <%= col.stage %>
              </div>
              <% } else { %>
              <% col.jobs.forEach(job => { %>
              <div class="kanban-card">
                <div class="kanban-card-company"><%= job.company %></div>
                <div class="kanban-card-role"><%= job.role || 'Software Engineer' %></div>

                <div class="kanban-card-meta">
                  <span><i data-lucide="map-pin" style="width: 12px; height: 12px;"></i> <%= job.location || 'Remote' %></span>
                  <% if (job.salary) { %>
                  <span style="font-weight: 600; color: var(--success);"><%= job.salary %></span>
                  <% } %>
                </div>

                <% if (job.notes) { %>
                <p style="font-size: 0.775rem; color: var(--text-secondary); margin-bottom: 0.75rem; line-height: 1.4;">
                  <%= job.notes %>
                </p>
                <% } %>

                <div class="kanban-move-actions">
                  <% if (colIndex > 0) { %>
                  <form action="/jobs/move/<%= job._id %>/back" method="POST" style="flex: 1;">
                    <button type="submit" class="kanban-move-btn" title="Move to previous stage">
                      <i data-lucide="chevron-left" style="width: 12px; height: 12px;"></i> Prev
                    </button>
                  </form>
                  <% } %>

                  <% if (colIndex < board.length - 1) { %>
                  <form action="/jobs/move/<%= job._id %>/forward" method="POST" style="flex: 1;">
                    <button type="submit" class="kanban-move-btn" title="Advance to next stage">
                      Next <i data-lucide="chevron-right" style="width: 12px; height: 12px;"></i>
                    </button>
                  </form>
                  <% } %>
                </div>

                <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 0.65rem; padding-top: 0.5rem; border-top: 1px dashed var(--border-subtle);">
                  <div style="display: flex; gap: 0.5rem;">
                    <a href="/jobs/edit/<%= job._id %>" style="font-size: 0.75rem; color: var(--primary); font-weight: 600;">Edit</a>
                    <% if (job.applyLink) { %>
                    <a href="<%= job.applyLink %>" target="_blank" style="font-size: 0.75rem; color: var(--text-secondary);">Apply Link ↗</a>
                    <% } %>
                  </div>

                  <form action="/jobs/delete/<%= job._id %>" method="POST" onsubmit="return confirm('Delete this job entry?')">
                    <button type="submit" style="background: none; border: none; color: var(--danger); font-size: 0.75rem; cursor: pointer; font-weight: 600;">Delete</button>
                  </form>
                </div>
              </div>
              <% }) %>
              <% } %>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
