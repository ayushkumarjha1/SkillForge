<header class="app-topbar">
  <div class="topbar-left">
    <button class="mobile-toggle" aria-label="Open Sidebar Menu">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
    </button>
    <div class="breadcrumbs">
      <a href="/dashboard" style="color: var(--text-muted); font-weight: 500;">SkillForge</a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-active" style="font-weight: 600; color: var(--text-primary);"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></span>
    </div>
  </div>

  <div class="topbar-right">
    <!-- Quick Search Command Trigger -->
    <button class="cmd-search-trigger" aria-label="Search Command Palette">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <span>Quick search...</span>
      <span class="cmd-kbd">Ctrl K</span>
    </button>

    <!-- Theme Switcher -->
    <button class="theme-toggle-btn" aria-label="Toggle Theme" title="Toggle Light / Dark Mode">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
    </button>

    <!-- Notifications Bell -->
    <a href="/notifications" class="topbar-icon-btn" aria-label="View Notifications" title="Notifications">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
      <span class="notification-badge-dot"></span>
    </a>
  </div>
</header>

<%- include("./command-palette") %>
