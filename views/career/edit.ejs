<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Edit Career Item — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'career' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Edit Career Item' }) %>

      <div class="app-content animate-fade-in" style="max-width: 700px;">
        <div class="page-header">
          <div>
            <h1 class="page-title">Edit Item</h1>
            <p class="page-subtitle">Update details for "<%= item.title %>".</p>
          </div>
          <div class="page-actions">
            <a href="/career" class="btn btn-secondary">
              <i data-lucide="arrow-left"></i>
              <span>Back to Planner</span>
            </a>
          </div>
        </div>

        <div class="card">
          <form action="/career/edit/<%= item._id %>" method="POST">
            <div class="form-group">
              <label class="form-label" for="title">Title *</label>
              <input type="text" id="title" name="title" class="form-control" value="<%= item.title %>" required>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="type">Item Type</label>
                <select id="type" name="type" class="form-select">
                  <% ["Goal","Task","Habit"].forEach(t => { %>
                  <option value="<%= t %>" <%= item.type === t ? "selected" : "" %>><%= t %></option>
                  <% }) %>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="status">Status</label>
                <select id="status" name="status" class="form-select">
                  <% ["Not Started","In Progress","Done"].forEach(s => { %>
                  <option value="<%= s %>" <%= item.status === s ? "selected" : "" %>><%= s %></option>
                  <% }) %>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="targetDate">Target Completion Date</label>
              <input type="text" id="targetDate" name="targetDate" class="form-control" value="<%= item.targetDate %>">
            </div>

            <div class="form-group">
              <label class="form-label" for="notes">Notes & Key Success Metrics</label>
              <textarea id="notes" name="notes" class="form-textarea"><%= item.notes %></textarea>
            </div>

            <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
              <a href="/career" class="btn btn-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary">
                <i data-lucide="check"></i>
                <span>Update Item</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
