<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Career Planner — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'career' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Career Strategy & Goals' }) %>

      <div class="app-content animate-fade-in">
        <div class="page-header">
          <div>
            <h1 class="page-title">Career Planner & Habits</h1>
            <p class="page-subtitle">Set long-term milestones, track weekly engineering tasks, and build daily habits.</p>
          </div>
          <div class="page-actions">
            <a href="/career/add" class="btn btn-primary">
              <i data-lucide="plus"></i>
              <span>Add Goal / Task / Habit</span>
            </a>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
          <% ["Goal","Task","Habit"].forEach(type => { %>
          <div class="card" style="display: flex; flex-direction: column;">
            <div class="card-header" style="margin-bottom: 1rem;">
              <div class="card-title">
                <i data-lucide="<%= type === 'Goal' ? 'target' : (type === 'Task' ? 'check-square' : 'flame') %>" style="color: <%= type === 'Goal' ? 'var(--primary)' : (type === 'Task' ? 'var(--info)' : 'var(--warning)') %>;"></i>
                <span><%= type %>s</span>
              </div>
              <span class="badge badge-neutral"><%= grouped[type].length %></span>
            </div>

            <% if (grouped[type].length === 0) { %>
            <div style="text-align: center; padding: 2.5rem 1rem; color: var(--text-muted); font-size: 0.85rem;">
              No <%= type.toLowerCase() %>s added yet.
            </div>
            <% } else { %>
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
              <% grouped[type].forEach(item => { %>
              <div style="background: var(--bg-subtle); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1rem;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.35rem;">
                  <div style="font-weight: 600; font-size: 0.95rem; color: var(--text-primary);"><%= item.title %></div>
                  <span class="badge <%= item.status === 'Done' ? 'badge-success' : (item.status === 'In Progress' ? 'badge-warning' : 'badge-neutral') %>" style="font-size: 0.7rem;">
                    <%= item.status %>
                  </span>
                </div>

                <% if (item.targetDate) { %>
                <div style="font-size: 0.775rem; color: var(--text-muted); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.35rem;">
                  <i data-lucide="calendar" style="width: 12px; height: 12px;"></i> Target: <%= item.targetDate %>
                </div>
                <% } %>

                <% if (item.notes) { %>
                <p style="font-size: 0.825rem; color: var(--text-secondary); margin-bottom: 0.75rem; line-height: 1.4;">
                  <%= item.notes %>
                </p>
                <% } %>

                <div style="display: flex; justify-content: flex-end; gap: 0.5rem; border-top: 1px dashed var(--border-subtle); padding-top: 0.5rem; margin-top: 0.5rem;">
                  <a href="/career/edit/<%= item._id %>" class="btn btn-ghost btn-sm btn-icon" title="Edit">
                    <i data-lucide="edit-2" style="width: 14px; height: 14px;"></i>
                  </a>
                  <form action="/career/delete/<%= item._id %>" method="POST" style="display: inline;" onsubmit="return confirm('Delete item?')">
                    <button type="submit" class="btn btn-ghost btn-sm btn-icon" style="color: var(--danger) !important;" title="Delete">
                      <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                    </button>
                  </form>
                </div>
              </div>
              <% }) %>
            </div>
            <% } %>
          </div>
          <% }) %>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
