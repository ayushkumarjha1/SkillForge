<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Add Career Planner Item — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'career' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Add Career Item' }) %>

      <div class="app-content animate-fade-in" style="max-width: 700px;">
        <div class="page-header">
          <div>
            <h1 class="page-title">Add Goal / Task / Habit</h1>
            <p class="page-subtitle">Define an actionable objective for your engineering career.</p>
          </div>
          <div class="page-actions">
            <a href="/career" class="btn btn-secondary">
              <i data-lucide="arrow-left"></i>
              <span>Back to Planner</span>
            </a>
          </div>
        </div>

        <div class="card">
          <form action="/career/add" method="POST">
            <div class="form-group">
              <label class="form-label" for="title">Title *</label>
              <input type="text" id="title" name="title" class="form-control" placeholder="e.g. Master System Design & Microservices" required autofocus>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="type">Item Type</label>
                <select id="type" name="type" class="form-select">
                  <option value="Goal">Goal (Long-term milestone)</option>
                  <option value="Task">Task (Actionable to-do)</option>
                  <option value="Habit">Habit (Daily/Weekly ritual)</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="status">Status</label>
                <select id="status" name="status" class="form-select">
                  <option value="Not Started">Not Started</option>
                  <option value="In Progress" selected>In Progress</option>
                  <option value="Done">Done</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="targetDate">Target Completion Date</label>
              <input type="text" id="targetDate" name="targetDate" class="form-control" placeholder="e.g. Q3 2026, Dec 15">
            </div>

            <div class="form-group">
              <label class="form-label" for="notes">Notes & Key Success Metrics</label>
              <textarea id="notes" name="notes" class="form-textarea" placeholder="Describe the criteria for success, resources needed..."></textarea>
            </div>

            <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
              <a href="/career" class="btn btn-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary">
                <i data-lucide="plus"></i>
                <span>Save Item</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
