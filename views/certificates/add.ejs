<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Add Certificate — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'certificates' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Add Certificate' }) %>

      <div class="app-content animate-fade-in" style="max-width: 700px;">
        <div class="page-header">
          <div>
            <h1 class="page-title">Add Certificate</h1>
            <p class="page-subtitle">Add a verified credential, certification exam, or hackathon badge.</p>
          </div>
          <div class="page-actions">
            <a href="/certificates" class="btn btn-secondary">
              <i data-lucide="arrow-left"></i>
              <span>Back to Certificates</span>
            </a>
          </div>
        </div>

        <div class="card">
          <form action="/certificates/add" method="POST" enctype="multipart/form-data">
            <div class="form-group">
              <label class="form-label" for="title">Certificate Title *</label>
              <input type="text" id="title" name="title" class="form-control" placeholder="e.g. AWS Certified Solutions Architect" required autofocus>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="issuer">Issuing Organization *</label>
                <input type="text" id="issuer" name="issuer" class="form-control" placeholder="e.g. Amazon Web Services, Coursera, Meta" required>
              </div>

              <div class="form-group">
                <label class="form-label" for="category">Category</label>
                <select id="category" name="category" class="form-select">
                  <option value="Course">Course</option>
                  <option value="Internship">Internship</option>
                  <option value="Hackathon">Hackathon</option>
                  <option value="Certification Exam" selected>Certification Exam</option>
                  <option value="Workshop">Workshop</option>
                  <option value="Other">Other</option>
                </select>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="issueDate">Issue Date</label>
                <input type="text" id="issueDate" name="issueDate" class="form-control" placeholder="e.g. June 2026">
              </div>

              <div class="form-group">
                <label class="form-label" for="credentialUrl">Verification URL</label>
                <input type="url" id="credentialUrl" name="credentialUrl" class="form-control" placeholder="https://www.credly.com/badges/...">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="image">Certificate Image / Badge (Optional)</label>
              <input type="file" id="image" name="image" class="form-control" accept="image/*">
            </div>

            <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
              <a href="/certificates" class="btn btn-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary">
                <i data-lucide="plus"></i>
                <span>Save Certificate</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
