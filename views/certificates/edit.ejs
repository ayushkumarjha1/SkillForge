<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Edit Certificate — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'certificates' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Edit Certificate' }) %>

      <div class="app-content animate-fade-in" style="max-width: 700px;">
        <div class="page-header">
          <div>
            <h1 class="page-title">Edit Certificate</h1>
            <p class="page-subtitle">Update credential info for "<%= certificate.title %>".</p>
          </div>
          <div class="page-actions">
            <a href="/certificates" class="btn btn-secondary">
              <i data-lucide="arrow-left"></i>
              <span>Back to Certificates</span>
            </a>
          </div>
        </div>

        <div class="card">
          <form action="/certificates/edit/<%= certificate._id %>" method="POST" enctype="multipart/form-data">
            <div class="form-group">
              <label class="form-label" for="title">Certificate Title *</label>
              <input type="text" id="title" name="title" class="form-control" value="<%= certificate.title %>" required>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="issuer">Issuing Organization *</label>
                <input type="text" id="issuer" name="issuer" class="form-control" value="<%= certificate.issuer %>" required>
              </div>

              <div class="form-group">
                <label class="form-label" for="category">Category</label>
                <select id="category" name="category" class="form-select">
                  <% ["Course","Internship","Hackathon","Certification Exam","Workshop","Other"].forEach(cat => { %>
                  <option value="<%= cat %>" <%= certificate.category === cat ? "selected" : "" %>><%= cat %></option>
                  <% }) %>
                </select>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="issueDate">Issue Date</label>
                <input type="text" id="issueDate" name="issueDate" class="form-control" value="<%= certificate.issueDate %>">
              </div>

              <div class="form-group">
                <label class="form-label" for="credentialUrl">Verification URL</label>
                <input type="url" id="credentialUrl" name="credentialUrl" class="form-control" value="<%= certificate.credentialUrl %>">
              </div>
            </div>

            <% if (certificate.image) { %>
            <div class="form-group">
              <label class="form-label">Current Image Preview</label>
              <div style="max-width: 240px; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border-subtle); margin-bottom: 0.5rem;">
                <img src="/uploads/certificates/<%= certificate.image %>" alt="Current Certificate" style="width: 100%; height: auto; display: block;">
              </div>
            </div>
            <% } %>

            <div class="form-group">
              <label class="form-label" for="image">Replace Image (Optional)</label>
              <input type="file" id="image" name="image" class="form-control" accept="image/*">
            </div>

            <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
              <a href="/certificates" class="btn btn-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary">
                <i data-lucide="check"></i>
                <span>Update Certificate</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
