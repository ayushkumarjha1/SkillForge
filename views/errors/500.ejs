<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>500 — Server Error | SkillForge</title>
</head>
<body class="auth-page">
  <div class="auth-glow-bg"></div>

  <div class="auth-container" style="text-align: center;">
    <div class="auth-brand">
      <a href="/" class="brand-link" style="justify-content: center;">
        <div class="brand-icon">
          <i data-lucide="sparkles"></i>
        </div>
        <span>SkillForge</span>
      </a>
    </div>

    <div class="auth-card" style="text-align: center;">
      <div style="font-size: 4.5rem; font-weight: 800; line-height: 1; letter-spacing: -0.04em; color: var(--danger); margin-bottom: 0.5rem;">
        500
      </div>
      <h1 class="auth-title">Internal Server Error</h1>
      <p class="auth-subtitle" style="margin-bottom: 1.5rem;">
        An unexpected issue occurred while processing your request.
      </p>

      <% if (typeof message !== "undefined" && message) { %>
      <div class="alert alert-danger" style="text-align: left; word-break: break-word;">
        <i data-lucide="alert-triangle" style="flex-shrink: 0; width: 18px; height: 18px;"></i>
        <span><%= message %></span>
      </div>
      <% } %>

      <div style="display: flex; gap: 0.75rem; justify-content: center; margin-top: 1.5rem;">
        <a href="/dashboard" class="btn btn-primary">
          <i data-lucide="layout-dashboard"></i>
          <span>Dashboard</span>
        </a>
        <a href="javascript:location.reload()" class="btn btn-secondary">
          <i data-lucide="refresh-cw"></i>
          <span>Retry</span>
        </a>
      </div>
    </div>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
