<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Admin Command Center — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'admin' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Admin Command Center' }) %>

      <div class="app-content animate-fade-in">
        <div class="page-header">
          <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
              <span class="badge badge-danger"><i data-lucide="shield-alert" style="width: 12px; height: 12px;"></i> Root Access</span>
            </div>
            <h1 class="page-title">Admin Command Center</h1>
            <p class="page-subtitle">Platform-wide telemetry, user authorization matrix, and account moderation.</p>
          </div>
        </div>

        <!-- Global Metrics Grid -->
        <div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); margin-bottom: 2rem;">
          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Total Users</span>
              <div class="stat-icon-wrapper" style="background: var(--primary-light); color: var(--primary);"><i data-lucide="users"></i></div>
            </div>
            <div class="stat-value" style="color: var(--primary);"><%= stats.totalUsers %></div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Projects</span>
              <div class="stat-icon-wrapper"><i data-lucide="folder-git-2"></i></div>
            </div>
            <div class="stat-value"><%= stats.projectCount %></div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">DSA Entries</span>
              <div class="stat-icon-wrapper" style="background: var(--success-light); color: var(--success);"><i data-lucide="code-2"></i></div>
            </div>
            <div class="stat-value" style="color: var(--success);"><%= stats.dsaCount %></div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Job Apps</span>
              <div class="stat-icon-wrapper" style="background: var(--accent-purple-light); color: var(--accent-purple);"><i data-lucide="briefcase"></i></div>
            </div>
            <div class="stat-value" style="color: var(--accent-purple);"><%= stats.jobCount %></div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Internships</span>
              <div class="stat-icon-wrapper" style="background: var(--info-light); color: var(--info);"><i data-lucide="building"></i></div>
            </div>
            <div class="stat-value" style="color: var(--info);"><%= stats.internshipCount %></div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Certificates</span>
              <div class="stat-icon-wrapper" style="background: var(--warning-light); color: var(--warning);"><i data-lucide="award"></i></div>
            </div>
            <div class="stat-value" style="color: var(--warning);"><%= stats.certCount %></div>
          </div>
        </div>

        <!-- User Management Table -->
        <div class="card" style="padding: 0; overflow: hidden;">
          <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center;">
            <h3 class="card-title" style="font-size: 1.05rem;"><i data-lucide="shield"></i> Registered Users Directory</h3>
            <span class="badge badge-neutral"><%= users.length %> Total</span>
          </div>

          <div class="table-container" style="border: none; border-radius: 0;">
            <table class="table">
              <thead>
                <tr>
                  <th>User</th>
                  <th>Role</th>
                  <th>Registered</th>
                  <th style="text-align: right;">Role Management & Actions</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach(u => { %>
                <tr>
                  <td>
                    <div style="font-weight: 600; color: var(--text-primary);"><%= u.fullName %></div>
                    <div style="font-size: 0.775rem; color: var(--text-muted);"><%= u.email %></div>
                  </td>
                  <td>
                    <span class="badge <%= u.role === 'admin' ? 'badge-danger' : (u.role === 'mentor' ? 'badge-warning' : (u.role === 'recruiter' ? 'badge-info' : 'badge-primary')) %>">
                      <%= u.role %>
                    </span>
                  </td>
                  <td style="font-size: 0.85rem; color: var(--text-secondary);">
                    <%= new Date(u.createdAt).toLocaleDateString() %>
                  </td>
                  <td style="text-align: right;">
                    <div style="display: inline-flex; align-items: center; gap: 0.5rem;">
                      <form action="/admin/role/<%= u._id %>" method="POST" style="margin: 0;">
                        <select name="role" class="form-select" style="padding: 0.35rem 0.65rem; font-size: 0.8rem; width: auto;" onchange="this.form.submit()">
                          <% ["student","mentor","recruiter","admin"].forEach(r => { %>
                          <option value="<%= r %>" <%= u.role === r ? "selected" : "" %>><%= r %></option>
                          <% }) %>
                        </select>
                      </form>

                      <form action="/admin/delete/<%= u._id %>" method="POST" style="margin: 0;" onsubmit="return confirm('Delete user <%= u.email %> permanently?')">
                        <button type="submit" class="btn btn-ghost btn-sm btn-icon" style="color: var(--danger) !important;" title="Delete User">
                          <i data-lucide="trash-2" style="width: 15px; height: 15px;"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
