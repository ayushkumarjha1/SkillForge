<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <link rel="stylesheet" href="/css/ai.css">
  <title>AI Career Coach — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'ai-coach' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'AI Career Coach' }) %>

      <div class="app-content animate-fade-in" style="max-width: 900px;">
        <div class="page-header">
          <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
              <span class="badge badge-primary"><i data-lucide="sparkles" style="width: 12px; height: 12px;"></i> AI Intelligence</span>
              <span style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono);">OpenRouter</span>
            </div>
            <h1 class="page-title">AI Career Coach</h1>
            <p class="page-subtitle">Generates tailored career advice synthesizing your profile, active projects, and roadmap milestones.</p>
          </div>
        </div>

        <% if (!configured) { %>
        <div class="alert alert-warning">
          <i data-lucide="alert-triangle" style="flex-shrink: 0; width: 20px; height: 20px;"></i>
          <div>
            <strong>OpenRouter API Key Required:</strong> Add <code>OPENROUTER_API_KEY=your_key</code> to your <code>.env</code> file to enable AI-powered career synthesis.
          </div>
        </div>
        <% } %>

        <% if (error) { %>
        <div class="alert alert-danger">
          <i data-lucide="alert-circle" style="flex-shrink: 0; width: 20px; height: 20px;"></i>
          <span><%= error %></span>
        </div>
        <% } %>

        <!-- Action Card -->
        <div class="card" style="background: linear-gradient(135deg, rgba(79, 70, 229, 0.04) 0%, rgba(139, 92, 246, 0.06) 100%); border-color: var(--border-glow); margin-bottom: 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
              <h3 style="font-size: 1.1rem; margin-bottom: 0.25rem;">Synthesize Profile Insights</h3>
              <p style="font-size: 0.85rem; color: var(--text-secondary); margin: 0;">Our AI agent will review your full tech profile and formulate an actionable strategic next step.</p>
            </div>
            <form action="/ai/coach" method="POST">
              <button type="submit" class="btn btn-primary" <%= configured ? '' : 'disabled' %>>
                <i data-lucide="sparkles"></i>
                <span>Generate Guidance</span>
              </button>
            </form>
          </div>
        </div>

        <% if (guidance) { %>
        <div class="ai-response-card animate-fade-in">
          <div class="ai-response-header">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <div class="stat-icon-wrapper" style="width: 28px; height: 28px; background: var(--primary-light); color: var(--primary);">
                <i data-lucide="sparkles" style="width: 14px; height: 14px;"></i>
              </div>
              <strong style="font-size: 0.95rem; color: var(--text-primary);">Personalized Career Synthesis</strong>
            </div>
            <span class="badge badge-success"><i data-lucide="check" style="width: 12px; height: 12px;"></i> Ready</span>
          </div>

          <div class="ai-response-content">
            <%= guidance %>
          </div>
        </div>
        <% } %>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
