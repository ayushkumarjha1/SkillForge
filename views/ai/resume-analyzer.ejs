<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <link rel="stylesheet" href="/css/ai.css">
  <title>AI Resume Analyzer — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'ai-resume' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'AI Resume Analyzer' }) %>

      <div class="app-content animate-fade-in" style="max-width: 900px;">
        <div class="page-header">
          <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
              <span class="badge badge-primary"><i data-lucide="sparkles" style="width: 12px; height: 12px;"></i> ATS Optimizer</span>
              <span style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono);">OpenRouter</span>
            </div>
            <h1 class="page-title">AI Resume Analyzer</h1>
            <p class="page-subtitle">Deep ATS algorithm scoring, keyword density analysis, and line-by-line feedback.</p>
          </div>
        </div>

        <% if (!configured) { %>
        <div class="alert alert-warning">
          <i data-lucide="alert-triangle" style="flex-shrink: 0; width: 20px; height: 20px;"></i>
          <div>
            <strong>OpenRouter API Key Required:</strong> Add <code>OPENROUTER_API_KEY=your_key</code> to your <code>.env</code> file to enable AI resume auditing.
          </div>
        </div>
        <% } %>

        <% if (error) { %>
        <div class="alert alert-danger">
          <i data-lucide="alert-circle" style="flex-shrink: 0; width: 20px; height: 20px;"></i>
          <span><%= error %></span>
        </div>
        <% } %>

        <div class="card" style="margin-bottom: 1.5rem;">
          <% if (resumes.length === 0) { %>
          <div class="empty-state" style="padding: 2rem;">
            <div class="empty-state-icon"><i data-lucide="file-text"></i></div>
            <h3 style="margin-bottom: 0.5rem;">No Resumes Available</h3>
            <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1rem;">Create a resume in the builder first before running an ATS analysis.</p>
            <a href="/resume" class="btn btn-primary btn-sm">Go to Resume Builder</a>
          </div>
          <% } else { %>
          <form action="/ai/resume-analyzer" method="POST">
            <div class="form-group">
              <label class="form-label" for="resumeId">Select Resume to Analyze</label>
              <select name="resumeId" id="resumeId" class="form-select">
                <% resumes.forEach(r => { %>
                <option value="<%= r._id %>" <%= selectedId === r._id.toString() ? "selected" : "" %>><%= r.title %> (<%= r.template %>)</option>
                <% }) %>
              </select>
            </div>

            <button type="submit" class="btn btn-primary" <%= configured ? '' : 'disabled' %>>
              <i data-lucide="sparkles"></i>
              <span>Analyze ATS Match & Score</span>
            </button>
          </form>
          <% } %>
        </div>

        <% if (analysis) { %>
        <div class="ai-response-card animate-fade-in">
          <div class="ai-response-header">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <div class="stat-icon-wrapper" style="width: 28px; height: 28px; background: var(--primary-light); color: var(--primary);">
                <i data-lucide="file-check" style="width: 14px; height: 14px;"></i>
              </div>
              <strong style="font-size: 0.95rem; color: var(--text-primary);">ATS Audit & Recommendations</strong>
            </div>
            <span class="badge badge-success"><i data-lucide="check" style="width: 12px; height: 12px;"></i> Audit Complete</span>
          </div>

          <div class="ai-response-content">
            <%= analysis %>
          </div>
        </div>
        <% } %>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
