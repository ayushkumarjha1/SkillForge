<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Resume Builder — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'resume' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Resume Builder' }) %>

      <div class="app-content animate-fade-in">
        <div class="page-header">
          <div>
            <h1 class="page-title">Resume Builder</h1>
            <p class="page-subtitle">Generate ATS-tailored developer resumes with auto-sync from your profile & projects.</p>
          </div>
          <div class="page-actions">
            <form action="/resume/create" method="POST">
              <button type="submit" class="btn btn-primary">
                <i data-lucide="sparkles"></i>
                <span>Create Auto-Filled Resume</span>
              </button>
            </form>
          </div>
        </div>

        <% if (resumesWithScores.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon">
            <i data-lucide="file-text" style="width: 32px; height: 32px;"></i>
          </div>
          <h2 class="empty-state-title">No Resumes Generated Yet</h2>
          <p class="empty-state-desc">
            Create your first resume. We'll automatically pull in your bio, skills, and projects to give you an instant head start.
          </p>
          <form action="/resume/create" method="POST">
            <button type="submit" class="btn btn-primary">
              <i data-lucide="plus"></i>
              <span>Create Resume Now</span>
            </button>
          </form>
        </div>
        <% } else { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
          <% resumesWithScores.forEach(item => { const r = item.doc; %>
          <div class="card card-hover" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
                <span class="badge badge-primary"><%= r.template %> Template</span>
                <span style="font-size: 0.75rem; color: var(--text-muted);">
                  Updated <%= new Date(r.updatedAt).toLocaleDateString() %>
                </span>
              </div>

              <h2 style="font-size: 1.25rem; margin-bottom: 0.75rem;"><%= r.title %></h2>

              <div style="margin-bottom: 1.25rem;">
                <div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.4rem;">
                  <span style="color: var(--text-secondary);">Completeness</span>
                  <span style="color: var(--primary);"><%= item.score %>%</span>
                </div>
                <div class="progress-bar-container">
                  <div class="progress-bar-fill" style="width: <%= item.score %>%;"></div>
                </div>
              </div>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border-subtle); padding-top: 1rem; margin-top: 1rem; gap: 0.5rem; flex-wrap: wrap;">
              <div style="display: flex; gap: 0.5rem;">
                <a href="/resume/<%= r._id %>/edit" class="btn btn-primary btn-sm">
                  <i data-lucide="edit-2" style="width: 14px; height: 14px;"></i>
                  <span>Edit</span>
                </a>
                <a href="/resume/<%= r._id %>/view" target="_blank" class="btn btn-secondary btn-sm">
                  <i data-lucide="printer" style="width: 14px; height: 14px;"></i>
                  <span>Export PDF</span>
                </a>
              </div>

              <a href="/resume/<%= r._id %>/delete" class="btn btn-ghost btn-sm btn-icon" style="color: var(--danger) !important;" title="Delete Resume" onclick="return confirm('Delete this resume?')">
                <i data-lucide="trash-2" style="width: 16px; height: 16px;"></i>
              </a>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
