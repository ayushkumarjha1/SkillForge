<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Portfolio Studio — SkillForge</title>
</head>
<body>
  <div class="app-wrapper">
    <%- include("../partials/app-sidebar", { activePage: 'portfolio' }) %>

    <main class="app-main">
      <%- include("../partials/app-topbar", { pageTitle: 'Portfolio Studio & Showcase' }) %>

      <div class="app-content animate-fade-in" style="max-width: 900px;">
        <div class="page-header">
          <div>
            <h1 class="page-title">Portfolio Studio</h1>
            <p class="page-subtitle">Configure your public showcase URL, theme appearance, and featured work.</p>
          </div>
          <div class="page-actions">
            <% if (profileUser.username) { %>
            <a href="/u/<%= profileUser.username %>" target="_blank" class="btn btn-primary">
              <i data-lucide="external-link"></i>
              <span>View Live Portfolio</span>
            </a>
            <% } %>
          </div>
        </div>

        <!-- URL & Appearance Card -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem;">
            <div>
              <div style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.35rem;">
                Public URL
              </div>
              <% if (profileUser.username) { %>
              <div style="font-size: 1.1rem; font-weight: 600;">
                <a href="/u/<%= profileUser.username %>" target="_blank" style="color: var(--primary); text-decoration: none;">
                  skillforge.com/u/<%= profileUser.username %> ↗
                </a>
              </div>
              <% } else { %>
              <div style="color: var(--text-muted); font-size: 0.9rem;">
                Set a custom username in <a href="/profile/edit" style="color: var(--primary); font-weight: 600;">Edit Profile</a> to activate your public link.
              </div>
              <% } %>
            </div>

            <form action="/portfolio/theme" method="POST" style="display: flex; gap: 0.5rem; align-items: center;">
              <select name="portfolioTheme" class="form-select" style="width: auto;">
                <option value="Dark" <%= profileUser.portfolioTheme === "Dark" ? "selected" : "" %>>Dark Mode Theme</option>
                <option value="Light" <%= profileUser.portfolioTheme === "Light" ? "selected" : "" %>>Light Mode Theme</option>
              </select>
              <button type="submit" class="btn btn-secondary">
                <i data-lucide="save"></i>
                <span>Save</span>
              </button>
            </form>
          </div>
        </div>

        <!-- Featured Projects Selection Card -->
        <div class="card">
          <div class="card-header" style="margin-bottom: 1rem;">
            <div>
              <h3 class="card-title" style="font-size: 1.1rem;">Featured Projects</h3>
              <p style="font-size: 0.825rem; color: var(--text-muted); margin-top: 0.2rem;">Choose which projects to highlight prominently on your public showcase.</p>
            </div>
            <a href="/projects/add" class="btn btn-secondary btn-sm">
              <i data-lucide="plus"></i>
              <span>New Project</span>
            </a>
          </div>

          <% if (projects.length === 0) { %>
          <div class="empty-state" style="padding: 2.5rem 1rem;">
            <div class="empty-state-icon"><i data-lucide="folder-plus"></i></div>
            <h3 style="margin-bottom: 0.5rem;">No Projects Available</h3>
            <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1rem;">Create a project entry first before pinning it to your public showcase.</p>
            <a href="/projects/add" class="btn btn-primary btn-sm">Add Project</a>
          </div>
          <% } else { %>
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <% projects.forEach(proj => { %>
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: var(--bg-subtle); border-radius: var(--radius-md); border: 1px solid var(--border-subtle); flex-wrap: wrap; gap: 0.75rem;">
              <div>
                <div style="font-weight: 600; font-size: 1rem; color: var(--text-primary); margin-bottom: 0.2rem;"><%= proj.title %></div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">
                  <span class="badge badge-neutral" style="margin-right: 0.5rem;"><%= proj.category %></span>
                  <span>Status: <strong><%= proj.status %></strong></span>
                </div>
              </div>

              <form action="/portfolio/toggle/<%= proj._id %>" method="POST">
                <button type="submit" class="btn <%= proj.featured ? 'btn-primary' : 'btn-secondary' %> btn-sm">
                  <i data-lucide="<%= proj.featured ? 'check' : 'plus' %>"></i>
                  <span><%= proj.featured ? 'Featured on Portfolio' : 'Pin to Portfolio' %></span>
                </button>
              </form>
            </div>
            <% }) %>
          </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts") %>
</body>
</html>
